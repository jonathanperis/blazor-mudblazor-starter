---
// Optional Google Analytics 4. Loads only when PUBLIC_GA_ID is a valid measurement ID; see the documentation guide.
const configured = import.meta.env.PUBLIC_GA_ID;
const GA_ID = typeof configured === 'string' && /^G-[A-Z0-9]+$/.test(configured) ? configured : undefined;
---

{GA_ID && (
  <>
    <script
      async
      src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}
    ></script>
    <script define:vars={{ GA_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', GA_ID);
    </script>
  </>
)}