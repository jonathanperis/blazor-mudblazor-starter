---
const repoUrl = 'https://github.com/jonathanperis/blazor-mudblazor-starter';
// Base-absolute links also work on the 404 page, which GitHub Pages serves at any unknown path.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<nav class="site-nav" aria-label="Primary navigation">
  <a class="logo" href={`${base}/`} aria-label="Blazor learning sandbox home">
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M12 3L4 7.25L12 11.5L20 7.25L12 3Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M4 12L12 16.25L20 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M4 16.75L12 21L20 16.75" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <span>Blazor learning sandbox</span>
  </a>
  <div class="nav-links">
    <a href={`${base}/demo/`}>Live demo</a>
    <a href={`${base}/docs/getting-started/`}>Run locally</a>
    <a href={`${base}/docs/`}>Docs</a>
    <a href={repoUrl} target="_blank" rel="noopener noreferrer">GitHub</a>
  </div>
</nav>
