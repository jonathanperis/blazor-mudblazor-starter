---
import BaseLayout from '@/layouts/BaseLayout.astro';
import '../../styles/docs.css';
import { SECTION_CATEGORIES, SECTION_ORDER, SLUG_LABEL } from '@/lib/sidebar.config';

const modules = import.meta.glob('../../../wiki/*.md', { eager: true });
const pages = Object.fromEntries(Object.entries(modules).map(([path, module]) => [path.split('/').pop()!.replace('.md', ''), module])) as Record<string, any>;
for (const slug of SECTION_ORDER) {
  if (!pages[slug]) throw new Error(`Missing wiki/${slug}.md`);
}
for (const slug of Object.keys(pages)) {
  if (!SECTION_ORDER.includes(slug)) throw new Error(`wiki/${slug}.md is missing from the sidebar`);
}
export function getStaticPaths() {
  return [{ params: { slug: undefined } }, ...SECTION_ORDER.filter(slug => slug !== 'home').map(slug => ({ params: { slug } }))];
}
const slug = Astro.params.slug ?? 'home';
const Content = pages[slug].default;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (id: string) => `${base}/docs/${id === 'home' ? '' : id + '/'}`;
---

<BaseLayout title={`${SLUG_LABEL[slug]} · Blazor learning sandbox`}>
  <div class="mobile-header">
    <button class="menu-toggle" id="menuToggle" aria-label="Open documentation navigation" aria-controls="sidebar" aria-expanded="false"><span></span><span></span><span></span></button>
    <span class="repo-title">Learning guide</span>
  </div>
  <div class="overlay" id="overlay"></div>
  <aside class="sidebar" id="sidebar" aria-label="Documentation navigation">
    <div class="sidebar-header">
      <p class="repo-title">Blazor learning sandbox</p>
      <p class="repo-description">Small experiments. Working source. Explicit tradeoffs.</p>
      <label for="searchInput" class="sr-only">Find a documentation topic</label>
      <input type="search" id="searchInput" class="search-box" placeholder="Find a topic..." />
      <p id="searchStatus" class="sr-only" role="status"></p>
    </div>
    <div class="sidebar-nav-container">
      {SECTION_CATEGORIES.map(category => (
        <div class="sidebar-category-group">
          <div class="sidebar-category">{category.label}</div>
          <ul>{category.ids.map(id => <li><a class:list={['nav-item', { active: id === slug }]} href={href(id)} aria-current={id === slug ? 'page' : undefined}>{SLUG_LABEL[id]}</a></li>)}</ul>
        </div>
      ))}
    </div>
    <div class="sidebar-footer">
      <a href={`${base}/`}>← Project overview</a>
      <a href="https://github.com/jonathanperis/blazor-mudblazor-starter" target="_blank" rel="noopener noreferrer">View source on GitHub</a>
    </div>
  </aside>
  <div class="content-wrapper" id="contentWrapper">
    <main class="content" id="main-content" tabindex="-1"><article class="doc-section"><Content /></article></main>
  </div>

  <script>
    const toggle = document.querySelector<HTMLButtonElement>('#menuToggle')!;
    const sidebar = document.querySelector<HTMLElement>('#sidebar')!;
    const overlay = document.querySelector<HTMLElement>('#overlay')!;
    const content = document.querySelector<HTMLElement>('#contentWrapper')!;
    const mobile = matchMedia('(max-width: 768px)');
    let open = false;
    function update() {
      sidebar.classList.toggle('open', open && mobile.matches);
      overlay.classList.toggle('open', open && mobile.matches);
      sidebar.inert = mobile.matches && !open;
      content.inert = mobile.matches && open;
      toggle.setAttribute('aria-expanded', String(open && mobile.matches));
      toggle.setAttribute('aria-label', open ? 'Close documentation navigation' : 'Open documentation navigation');
    }
    function close() { open = false; update(); toggle.focus(); }
    toggle.addEventListener('click', () => {
      if (open) close();
      else { open = true; update(); sidebar.querySelector<HTMLInputElement>('input')?.focus(); }
    });
    overlay.addEventListener('click', close);
    mobile.addEventListener('change', () => { open = false; update(); });
    document.addEventListener('keydown', event => {
      if (!mobile.matches || !open) return;
      if (event.key === 'Escape') { event.preventDefault(); close(); }
      if (event.key === 'Tab') {
        const controls = [toggle, ...sidebar.querySelectorAll<HTMLElement>('a[href], input')].filter(element => element.getClientRects().length);
        const first = controls[0], last = controls[controls.length - 1];
        if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
        else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
      }
    });
    const search = document.querySelector<HTMLInputElement>('#searchInput')!;
    search.addEventListener('input', () => {
      const query = search.value.trim().toLowerCase();
      let matches = 0;
      sidebar.querySelectorAll<HTMLLIElement>('li').forEach(item => {
        item.hidden = !(item.textContent ?? '').toLowerCase().includes(query);
        if (!item.hidden) matches++;
      });
      sidebar.querySelectorAll<HTMLElement>('.sidebar-category-group').forEach(group => { group.hidden = !group.querySelector('li:not([hidden])'); });
      document.querySelector('#searchStatus')!.textContent = `${matches} topics found`;
    });
    update();
  </script>
  <noscript><style>.sidebar { transform: none; position: static; width: 100%; height: auto; } .mobile-header, .search-box { display: none; } .content-wrapper { margin-left: 0; width: 100%; } body { display: block; }</style></noscript>
</BaseLayout>
