---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Masthead from '@/components/Masthead.astro';
import Colophon from '@/components/Colophon.astro';
import { PAGE_METADATA, SECTION_CATEGORIES, SECTION_ORDER } from '@/lib/sidebar.config';

const modules = import.meta.glob('../../../wiki/*.md', { eager: true });
const pages = Object.fromEntries(Object.entries(modules).map(([path, module]) => [path.split('/').pop()!.replace('.md', ''), module])) as Record<string, any>;
for (const slug of SECTION_ORDER) {
  if (!pages[slug]) throw new Error(`Missing wiki/${slug}.md`);
  if (!PAGE_METADATA[slug]) throw new Error(`Missing page metadata for ${slug}`);
}
for (const slug of Object.keys(pages)) {
  if (!SECTION_ORDER.includes(slug)) throw new Error(`wiki/${slug}.md is missing from the sidebar`);
}
export function getStaticPaths() {
  return [{ params: { slug: undefined } }, ...SECTION_ORDER.filter(slug => slug !== 'home').map(slug => ({ params: { slug } }))];
}
const slug = Astro.params.slug ?? 'home';
const page = pages[slug];
const Content = page.default;
const headings: { depth: number; slug: string; text: string }[] = typeof page.getHeadings === 'function' ? page.getHeadings() : [];
const sections = headings.filter((heading) => heading.depth === 2);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (id: string) => `${base}/docs/${id === 'home' ? '' : id + '/'}`;
const index = SECTION_ORDER.indexOf(slug);
const previous = index > 0 ? SECTION_ORDER[index - 1] : undefined;
const next = index < SECTION_ORDER.length - 1 ? SECTION_ORDER[index + 1] : undefined;
const roman = ['I', 'II', 'III', 'IV', 'V'];
---

<BaseLayout title={`${PAGE_METADATA[slug].label} · Blazor learning sandbox`} description={PAGE_METADATA[slug].description}>
  <Masthead current="guide" />
  <div class="guide">
    <details class="guide-contents" id="guide-contents" open>
      <summary>Contents</summary>
      <nav class="guide-nav" aria-label="Guide">
        {SECTION_CATEGORIES.map((category, part) => (
          <>
            <p class="guide-part">Part {roman[part]} · {category.label}</p>
            <ol>
              {category.ids.map((id) => (
                <li><a href={href(id)} aria-current={id === slug ? 'page' : undefined}><span>{part + 1}.{category.ids.indexOf(id) + 1}</span><span>{PAGE_METADATA[id].label}</span></a></li>
              ))}
            </ol>
          </>
        ))}
        <div class="guide-extra">
          <a href={`${base}/demo/`}>Open the live demo</a>
          <a href={`${base}/`}>Project overview</a>
          <a href="https://github.com/jonathanperis/blazor-mudblazor-starter" rel="noopener noreferrer">Source on GitHub</a>
        </div>
      </nav>
    </details>

    <main class="prose" id="main-content" tabindex="-1">
      <article><Content /></article>
      <nav class="pager" aria-label="Previous and next topics">
        {previous ? <a href={href(previous)} rel="prev"><small>Previous</small><span>{PAGE_METADATA[previous].label}</span></a> : <span></span>}
        {next ? <a href={href(next)} rel="next" class="pager-next"><small>Next</small><span>{PAGE_METADATA[next].label}</span></a> : <span></span>}
      </nav>
    </main>

    {sections.length > 1 && (
      <aside class="guide-onpage" aria-label="On this page">
        <p>On this page</p>
        <ol>{sections.map((section) => <li><a href={`#${section.slug}`}>{section.text}</a></li>)}</ol>
      </aside>
    )}
  </div>
  <Colophon />

  <script>
    // The contents start open (useful without JavaScript); on small screens they collapse behind a native disclosure.
    const contents = document.querySelector<HTMLDetailsElement>('#guide-contents')!;
    const wide = matchMedia('(min-width: 980px)');
    const sync = () => { contents.open = wide.matches; };
    sync();
    wide.addEventListener('change', sync);

    // Wide tables scroll inside a focusable region that keeps native table semantics.
    document.querySelectorAll<HTMLTableElement>('.prose table').forEach((table) => {
      const region = document.createElement('div');
      region.className = 'table-scroll';
      region.tabIndex = 0;
      region.setAttribute('role', 'region');
      region.setAttribute('aria-label', 'Scrollable table');
      table.replaceWith(region);
      region.append(table);
    });
    document.querySelectorAll<HTMLPreElement>('.prose pre').forEach((pre) => {
      if (pre.scrollWidth > pre.clientWidth) pre.setAttribute('aria-label', 'Scrollable code');
    });
  </script>
</BaseLayout>
