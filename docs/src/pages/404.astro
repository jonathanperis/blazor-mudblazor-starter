---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Masthead from '@/components/Masthead.astro';
import Colophon from '@/components/Colophon.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout noindex title="Page not found · Blazor learning sandbox" description="This page does not exist. Open the learning guide, the live WebAssembly demo, or the project overview.">
  {/*
    GitHub Pages answers every unknown path with this page. The WebAssembly demo is a single-page app, so a deep
    link such as /demo/labs/api must load demo/index.html; the demo restores the original path from ?p=.
  */}
  <script is:inline slot="head" define:vars={{ base }}>
    (function () {
      var demo = base + '/demo/';
      var path = window.location.pathname;
      if (path.indexOf(demo) === 0 && path.length > demo.length) {
        var route = '/' + path.slice(demo.length) + window.location.search + window.location.hash;
        window.location.replace(demo + '?p=' + encodeURIComponent(route));
      }
    })();
  </script>
  <Masthead />
  <main id="main-content" tabindex="-1">
    <section class="hero" aria-labelledby="not-found-title">
      <div>
        <p class="kicker">Error 404 · page not found</p>
        <h1 id="not-found-title" class="display">This page is <em>missing</em> from the manual.</h1>
        <p class="lede">The address does not match a page. It may have moved when the guide was reorganized.</p>
        <div class="actions">
          <a class="button" href={`${base}/docs/`}>Open the guide <span aria-hidden="true">→</span></a>
          <a class="link-arrow" href={`${base}/demo/`}>Open the live demo</a>
          <a class="link-arrow" href={`${base}/`}>Project overview</a>
        </div>
      </div>
    </section>
  </main>
  <Colophon />
</BaseLayout>
