---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Navbar from '@/components/home/Navbar.astro';
import Hero from '@/components/home/Hero.astro';
import Dashboard from '@/components/home/Dashboard.astro';
import Footer from '@/components/home/Footer.astro';

const title = 'Blazor MudBlazor Starter | Production-ready .NET template';
const description = 'Production-ready Blazor Server starter template with MudBlazor Material Design components, .NET 9, Docker, GHCR, Azure deployment, CodeQL, and GitHub Pages documentation.';
---

<BaseLayout title={title} description={description}>
  <Navbar />

  <main>
    <Hero />
    <Dashboard />
  </main>

  <Footer />
</BaseLayout>
