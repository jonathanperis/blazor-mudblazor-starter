---
import '../styles/globals.css';
import Analytics from '../components/Analytics.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Blazor MudBlazor Starter | Production-ready .NET template',
  description = 'Production-ready Blazor Server starter template with MudBlazor Material Design components, .NET 9, Docker, GHCR, Azure deployment, CodeQL, and GitHub Pages documentation.'
} = Astro.props;

const pageUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : `https://jonathanperis.github.io${Astro.url.pathname}`;
const basePath = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const faviconHref = `${basePath}favicon.ico`;
const faviconPngHref = `${basePath}favicon.png`;
const appleTouchIconHref = `${basePath}apple-touch-icon.png`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  'name': 'Blazor MudBlazor Starter',
  'description': description,
  'url': pageUrl,
  'applicationCategory': 'DeveloperApplication',
  'operatingSystem': 'Web',
  'codeRepository': 'https://github.com/jonathanperis/blazor-mudblazor-starter',
  'programmingLanguage': 'C#',
  'license': 'https://github.com/jonathanperis/blazor-mudblazor-starter/blob/main/LICENSE',
  'author': {
    '@type': 'Person',
    'name': 'Jonathan Peris',
    'url': 'https://jonathanperis.github.io/'
  }
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&family=Roboto+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <meta name="description" content={description} />
    <meta name="keywords" content="Blazor, MudBlazor, .NET 9, Material Design, Azure, Docker, GHCR, C#, Blazor Server, starter template, GitHub Pages" />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" href={faviconHref} sizes="any" />
    <link rel="icon" type="image/png" href={faviconPngHref} />
    <link rel="apple-touch-icon" href={appleTouchIconHref} />
    <meta name="theme-color" content="#673ab7" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="Blazor MudBlazor Starter" />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:creator" content="@jperis_silva" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <title>{title}</title>
    <Analytics />
  </head>
  <body>
    <slot />
  </body>
</html>
