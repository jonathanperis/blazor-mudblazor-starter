---
import '../styles/globals.css';
import Analytics from '../components/Analytics.astro';

interface Props {
  title?: string;
  description?: string;
  /** Error pages are not indexed and have no canonical address. */
  noindex?: boolean;
}

const {
  title = 'Blazor learning sandbox | MudBlazor labs',
  noindex = false,
  description = 'Hands-on Blazor and MudBlazor labs: state, forms, data grids, APIs, SQLite, authentication, localization, files, and observability. Learn locally with Docker and hosting exercises.'
} = Astro.props;

const pageUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : `https://jonathanperis.github.io${Astro.url.pathname}`;
const basePath = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const faviconHref = `${basePath}favicon.ico`;
const faviconPngHref = `${basePath}favicon.png`;
const appleTouchIconHref = `${basePath}apple-touch-icon.png`;
const sitemapHref = `${basePath}sitemap-index.xml`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  'name': 'Blazor learning sandbox',
  'description': description,
  'url': pageUrl,
  'codeRepository': 'https://github.com/jonathanperis/blazor-mudblazor-starter',
  'programmingLanguage': 'C#',
  'license': 'https://github.com/jonathanperis/blazor-mudblazor-starter/blob/main/LICENSE',
  'author': {
    '@type': 'Person',
    'name': 'Jonathan Peris',
    'url': 'https://jonathanperis.github.io/'
  }
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={pageUrl} />}
    <link rel="sitemap" href={sitemapHref} />
    <link rel="icon" href={faviconHref} sizes="any" />
    <link rel="icon" type="image/png" href={faviconPngHref} />
    <link rel="apple-touch-icon" href={appleTouchIconHref} />
    <meta name="theme-color" content="#673ab7" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="Blazor learning sandbox" />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:creator" content="@jperis_silva" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <title>{title}</title>
    <slot name="head" />
    <Analytics />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <slot />
  </body>
</html>
