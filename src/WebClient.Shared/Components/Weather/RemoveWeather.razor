<MudDialog>
    <DialogContent>Remove @Count selected records? Use Reset dataset to regenerate the original sample.</DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">Cancel</MudButton>
        <MudButton Color="Color.Error" OnClick="() => MudDialog.Close(DialogResult.Ok(true))">Remove records</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public int Count { get; set; }
}
