<EditForm Model="_draft" OnValidSubmit="Confirm">
    <DataAnnotationsValidator />
    <MudDialog>
        <DialogContent><ForecastFields Model="_draft" /></DialogContent>
        <DialogActions>
            <MudButton OnClick="Cancel">Cancel</MudButton>
            <MudButton ButtonType="ButtonType.Submit" Color="Color.Primary">Save changes</MudButton>
        </DialogActions>
    </MudDialog>
</EditForm>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter, EditorRequired] public WeatherForecast Item { get; set; } = null!;
    private WeatherForecast _draft = new();
    protected override void OnInitialized() => _draft = Item.Copy();
    private void Cancel() => MudDialog.Cancel();
    private void Confirm() => MudDialog.Close(DialogResult.Ok(_draft));
}
