@page "/labs/persistence"
@using WebClient.Shared.Features.Notebook
@inject INotebookStore Notebook
@inject LearningHost Host
@inject ILogger<Persistence> Logger
@implements IDisposable

<LabFrame Slug="persistence">
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">Notes are kept in @Host.NotebookStorage. Demo persona changes do not change your workspace. A workspace holds at most @INotebookStore.MaxNotes notes.</MudAlert>
    <EditForm Model="_draft" OnValidSubmit="Save" @key="_draft">
        <DataAnnotationsValidator />
        <MudTextField Label="Title" @bind-Value="_draft.Title" For="@(() => _draft.Title)" MaxLength="120" />
        <MudTextField Label="What did you learn?" @bind-Value="_draft.Text" For="@(() => _draft.Text)" MaxLength="4000" Lines="3" />
        <ValidationSummary />
        <MudStack Row Class="flex-wrap my-3">
            <MudButton ButtonType="ButtonType.Submit" Disabled="_busy" Color="Color.Primary" Variant="Variant.Filled">@(_editing is null ? "Add note" : "Save draft")</MudButton>
            <MudButton OnClick="NewDraft" Disabled="_busy">Cancel / new draft</MudButton>
            <MudButton OnClick="Load" Disabled="_busy">Reload notes</MudButton>
        </MudStack>
    </EditForm>
    <MudText Class="my-3" role="status">@_status</MudText>
    @if (Notes is null)
    {
        <MudText>Loading notes…</MudText>
    }
    else
    {
        @foreach (var note in Notes)
        {
            <MudPaper Outlined Class="pa-3 mb-3" @key="note.Id">
                <MudText Typo="Typo.h6" HtmlTag="h2">@note.Title</MudText>
                <MudText Style="white-space: pre-wrap">@note.Text</MudText>
                <MudText Typo="Typo.caption">Version: @note.Version.ToString("N")[..8]</MudText>
                <MudStack Row><MudButton OnClick="() => Edit(note)" Disabled="_busy">Edit draft</MudButton><MudButton OnClick="() => Delete(note)" Disabled="_busy" Color="Color.Error">Delete</MudButton></MudStack>
            </MudPaper>
        }
        @if (Notes.Count == 0) { <MudText>No notes yet. Write down the first thing you learned.</MudText> }
    }
    <MudCheckBox T="bool" @bind-Value="_confirmReset" Label="I want to remove all notes in my workspace" />
    <MudButton Color="Color.Error" OnClick="Reset" Disabled="@(!_confirmReset || _busy)">Reset my notebook</MudButton>
</LabFrame>

@code {
    // Carried from prerendering to the interactive render, so a page load reads the notebook once.
    [PersistentState] public List<NoteSnapshot>? Notes { get; set; }
    private NoteDraft _draft = new();
    private NoteSnapshot? _editing;
    private string _status = "";
    private bool _busy;
    private bool _confirmReset;
    private int _loadGeneration;
    private readonly CancellationTokenSource _lifetime = new();

    protected override async Task OnInitializedAsync()
    {
        if (Notes is null) await Load();
        else _status = LoadedStatus(Notes.Count);
    }

    private static string LoadedStatus(int count) => $"Loaded {count} notes. An open draft keeps its original version until you choose Edit again.";

    private async Task Load()
    {
        // Only the newest load may assign the list; an older, slower read must not overwrite it.
        var generation = ++_loadGeneration;
        try
        {
            var notes = await Notebook.ListAsync(_lifetime.Token);
            if (generation != _loadGeneration) return;
            Notes = notes;
            _status = LoadedStatus(notes.Count);
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { Logger.LogDebug("Notebook load canceled: the page was disposed."); }
        catch (NotebookUnavailableException error) when (generation == _loadGeneration) { Notes = []; _status = error.Message; }
    }

    private void NewDraft() { _editing = null; _draft = new(); }
    private void Edit(NoteSnapshot note) { _editing = note; _draft = new() { Title = note.Title, Text = note.Text }; }

    private async Task Execute(Func<CancellationToken, Task> operation)
    {
        if (_busy) return;
        _busy = true;
        try { await operation(_lifetime.Token); await Load(); NewDraft(); _status = "Notebook updated."; }
        catch (NotebookConflictException) { _status = "Conflict: another tab changed or deleted this note. Your draft is retained. Reload notes, then select Edit to start from the current version."; }
        catch (Exception error) when (error is NotebookLimitException or NotebookUnavailableException) { _status = error.Message; }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { Logger.LogDebug("Notebook update canceled: the page was disposed."); }
        finally { _busy = false; }
    }

    private Task Save() => Execute(token => Notebook.SaveAsync(_draft, _editing, token));
    private Task Delete(NoteSnapshot note) => Execute(token => Notebook.DeleteAsync(note, token));
    private async Task Reset() { if (!_confirmReset) return; await Execute(token => Notebook.ResetAsync(token)); _confirmReset = false; }

    public void Dispose() { _lifetime.Cancel(); _lifetime.Dispose(); }
}
