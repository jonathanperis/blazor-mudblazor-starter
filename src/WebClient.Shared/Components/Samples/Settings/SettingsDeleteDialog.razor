@* A destructive confirmation the reader has to mean: typing the email enables the button. *@
@implements IDisposable

<MudDialog>
    <TitleContent>
        <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Outlined.WarningAmber" Color="Color.Error" />
            <MudText Typo="Typo.h6" HtmlTag="h2">Delete your account?</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudText Typo="Typo.body2">
                Your profile, notes and notification settings are removed after a 14-day grace period. Rotas and bake sheets keep your initials for food-safety records.
            </MudText>
            <MudTextField T="string" @bind-Value="_typed" Immediate Label="@($"Type {Email} to confirm")" Variant="Variant.Outlined" Disabled="_deleting" autocomplete="off" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()" Disabled="_deleting">Keep my account</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" Disabled="@(!Confirmed || _deleting)" OnClick="DeleteAsync">
            @if (_deleting)
            {
                <MudProgressCircular Indeterminate Size="Size.Small" Class="mr-2" />
                <span>Scheduling…</span>
            }
            else
            {
                <span>Delete account</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private readonly CancellationTokenSource _lifetime = new();
    private string _typed = "";
    private bool _deleting;

    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;
    [Parameter, EditorRequired] public string Email { get; set; } = "";

    private bool Confirmed => string.Equals(_typed.Trim(), Email, StringComparison.OrdinalIgnoreCase);

    private async Task DeleteAsync()
    {
        _deleting = true;
        try
        {
            await Task.Delay(1000, _lifetime.Token);
            Dialog.Close(DialogResult.Ok(true));
        }
        catch (OperationCanceledException)
        {
            // Closed while scheduling: nothing happened.
        }
    }

    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
