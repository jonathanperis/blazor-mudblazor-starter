@* Project cards: status, progress, team and a star the reader can toggle. *@
@inject ISnackbar Snackbar

<MudStack Spacing="3">
    <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
        <MudSwitch T="bool" @bind-Value="_hidePublished" Color="Color.Primary" Label="Hide published" />
        <div style="width: 13rem">
            <MudSelect T="string" @bind-Value="_sort" Label="Sort by" Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem Value="@("stars")">Most starred</MudSelectItem>
                <MudSelectItem Value="@("progress")">Furthest along</MudSelectItem>
                <MudSelectItem Value="@("name")">Name</MudSelectItem>
            </MudSelect>
        </div>
    </MudStack>

    <MudGrid Spacing="3">
        @foreach (var project in Visible)
        {
            var starred = _starred.Contains(project.Name);
            <MudItem xs="12" sm="6">
                <MudCard Outlined Style="height: 100%; display: flex; flex-direction: column">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6" HtmlTag="h3">@project.Name</MudText>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="ProfileData.StatusColor(project.Status)" Class="ml-0 mt-1">@project.Status</MudChip>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            <MudTooltip Text="@(starred ? "Remove star" : "Star this project")">
                                <MudIconButton Icon="@(starred ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)" Color="@(starred ? Color.Warning : Color.Default)"
                                               OnClick="() => ToggleStar(project)" aria-pressed="@(starred ? "true" : "false")" aria-label="@($"Star {project.Name}")" />
                            </MudTooltip>
                        </CardHeaderActions>
                    </MudCardHeader>
                    <MudCardContent Class="pt-0" Style="flex: 1">
                        <MudText Typo="Typo.body2">@project.Summary</MudText>
                        <MudStack Row Justify="Justify.SpaceBetween" Class="mt-4 mb-1">
                            <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary)">Progress</MudText>
                            <MudText Typo="Typo.caption" Style="font-variant-numeric: tabular-nums">@project.Progress %</MudText>
                        </MudStack>
                        <MudProgressLinear Value="project.Progress" Color="ProfileData.StatusColor(project.Status)" Rounded aria-label="@($"{project.Name} progress")" />
                        <MudStack Row Wrap="Wrap.Wrap" Spacing="1" Class="mt-3">
                            @foreach (var tag in project.Tags)
                            {
                                <MudChip T="string" Size="Size.Small" Class="ml-0">@tag</MudChip>
                            }
                        </MudStack>
                    </MudCardContent>
                    <MudCardActions Class="px-4 pb-4 d-flex justify-space-between align-center">
                        <MudAvatarGroup Max="3" Spacing="2" MaxSize="Size.Small" Outlined OutlineColor="Color.Surface">
                            @foreach (var member in project.Team)
                            {
                                <MudAvatar Size="Size.Small" Color="Color.Secondary" title="@member" Style="font-size: .7rem">@ProfileData.Initials(member)</MudAvatar>
                            }
                        </MudAvatarGroup>
                        <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary); font-variant-numeric: tabular-nums">
                            <MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" Style="vertical-align: -4px; font-size: 1rem" /> @(project.Stars + (starred ? 1 : 0)) stars
                        </MudText>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
</MudStack>

@code {
    private readonly HashSet<string> _starred = [];
    private bool _hidePublished;
    private string _sort = "stars";

    private IEnumerable<ProfileProject> Visible
    {
        get
        {
            var projects = ProfileData.Projects.Where(project => !_hidePublished || project.Status != ProjectStatus.Published);
            return _sort switch
            {
                "progress" => projects.OrderByDescending(project => project.Progress),
                "name" => projects.OrderBy(project => project.Name, StringComparer.Ordinal),
                _ => projects.OrderByDescending(project => project.Stars + (_starred.Contains(project.Name) ? 1 : 0))
            };
        }
    }

    private void ToggleStar(ProfileProject project)
    {
        if (_starred.Remove(project.Name)) return;
        _starred.Add(project.Name);
        Snackbar.Add($"Starred {project.Name}. You'll see its updates in your feed.", Severity.Normal);
    }
}
