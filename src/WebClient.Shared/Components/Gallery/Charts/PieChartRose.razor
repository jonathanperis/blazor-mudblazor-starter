<MudChart T="double" ChartType="ChartType.Rose" ChartSeries="_series" ChartLabels="_months" ChartOptions="_options"
          LegendPosition="Position.Right" Width="100%" Height="320px" />

<MudGrid Spacing="3" Class="mt-2">
    <MudItem xs="12" sm="6">
        <MudSlider T="double" @bind-Value="_options.AngleOffset" Min="0" Max="90" Step="15" Color="Color.Primary" aria-label="Angle offset">Angle offset: @_options.AngleOffset°</MudSlider>
    </MudItem>
    <MudItem xs="12" sm="6">
        <MudSlider T="double" @bind-Value="_options.ScaleFactor" Min="0.5" Max="1" Step="0.1" Color="Color.Primary" aria-label="Scale factor">Scale factor: @_options.ScaleFactor.ToString("0.0")</MudSlider>
    </MudItem>
</MudGrid>

@code {
    private readonly string[] _months = ["October", "November", "December", "January", "February", "March"];

    // Visitors to the observatory's public nights over one winter season.
    private readonly List<ChartSeries<double>> _series =
    [
        new() { Name = "Visitors", Data = new double[] { 420, 610, 380, 290, 510, 470 } }
    ];

    private readonly RoseChartOptions _options = new()
    {
        ChartPalette = ["#2F7FC1", "#D9622B", "#0B9585", "#B07D0E", "#A65DB0", "#4F9A2E"],
        ShowValues = true,
        AngleOffset = 0,
        ScaleFactor = 0.9
    };
}
