<MudChart T="double" ChartType="ChartType.ScatterPlot" ChartSeries="_series" ChartOptions="_options" Width="100%" Height="320px" />

<MudGrid Spacing="2" Class="mt-2">
    <MudItem xs="12" sm="6" md="3">
        <MudSlider T="double" @bind-Value="_options.PointRadius" Min="2" Max="10" Color="Color.Primary">Point radius: @_options.PointRadius</MudSlider>
    </MudItem>
    <MudItem xs="12" sm="6" md="3"><MudSwitch T="bool" @bind-Value="_options.ShowDataLabels" Label="Value labels" Color="Color.Primary" /></MudItem>
    <MudItem xs="12" sm="6" md="3"><MudSwitch T="bool" @bind-Value="_options.ShowToolTips" Label="Tooltips" Color="Color.Primary" /></MudItem>
    <MudItem xs="12" sm="6" md="3"><MudSwitch T="bool" @bind-Value="_options.XAxisLines" Label="Vertical grid lines" Color="Color.Primary" /></MudItem>
</MudGrid>

@code {
    // Comets seen from the observatory: distance from the Sun against brightness (lower magnitude is brighter).
    private readonly List<ChartSeries<double>> _series =
    [
        new()
        {
            Name = "Comet sightings",
            Data = new([(0.6, 2.1), (0.8, 3.4), (1.0, 4.2), (1.3, 5.9), (1.5, 6.4), (1.9, 8.1), (2.2, 9.0), (2.6, 10.6)])
        }
    ];

    private readonly ScatterPlotChartOptions _options = new()
    {
        ChartPalette = ["#0B9585"],
        XAxisTitle = "Distance from the Sun (AU)",
        YAxisTitle = "Magnitude",
        XAxisTicks = 1,
        YAxisTicks = 2,
        PointRadius = 6,
        ShowDataLabels = false,
        ShowToolTips = true,
        XAxisLines = true,
        ShowLegend = false
    };
}
