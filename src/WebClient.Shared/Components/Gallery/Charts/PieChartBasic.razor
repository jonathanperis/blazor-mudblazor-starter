<MudChart T="double" ChartType="ChartType.Pie" ChartSeries="_series" ChartLabels="_sources" ChartOptions="_options"
          LegendPosition="Position.Right" Width="100%" Height="300px" />

<MudStack Row Spacing="4" Class="mt-2">
    <MudSwitch T="bool" @bind-Value="_options.ShowValues" Label="Show values" Color="Color.Primary" />
    <MudSwitch T="bool" @bind-Value="_options.ShowAsPercentage" Label="As percentages" Color="Color.Primary" Disabled="@(!_options.ShowValues)" />
</MudStack>

@code {
    private readonly string[] _sources = ["Wind", "Solar", "Gas", "Hydro", "Biomass"];

    // Electricity generated in the town last year, in gigawatt-hours.
    private readonly List<ChartSeries<double>> _series =
    [
        new() { Name = "Generation (GWh)", Data = new double[] { 264, 182, 141, 96, 38 } }
    ];

    // A categorical palette checked for contrast and color-vision separation on both the light and dark surfaces.
    private readonly PieChartOptions _options = new()
    {
        ChartPalette = ["#2F7FC1", "#D9622B", "#0B9585", "#B07D0E", "#A65DB0", "#4F9A2E"],
        ShowValues = true,
        ShowAsPercentage = true
    };
}
