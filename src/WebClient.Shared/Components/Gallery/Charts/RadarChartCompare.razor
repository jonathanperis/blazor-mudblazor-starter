        new() { Name = "Country sourdough", Data = new double[] { 9, 7.5, 8, 3, 8.5, 7 } },
        new() { Name = "Dark rye", Data = new double[] { 7, 6, 6.5, 4, 9, 9 } },
        new() { Name = "Brioche", Data = new double[] { 4, 9, 1, 9, 7.5, 4 } }
    ];

    // A categorical palette checked for contrast and color-vision separation on both the light and dark surfaces.
