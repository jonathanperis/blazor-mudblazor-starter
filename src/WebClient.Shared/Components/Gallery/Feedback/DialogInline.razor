<MudStack Row Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Spacing="3">
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Tune" OnClick="Open">Reading preferences</MudButton>
    <MudText Typo="Typo.body2">Font size @_fontSize px, @(_serif ? "serif" : "sans-serif").</MudText>
</MudStack>

<MudDialog @bind-Visible="_visible" Options="_options">
    <TitleContent>
        <MudText Typo="Typo.h6">Reading preferences</MudText>
    </TitleContent>
    <DialogContent>
        <MudSlider @bind-Value="_draftFontSize" Min="12" Max="24" Step="1" Color="Color.Primary">Font size: @_draftFontSize px</MudSlider>
        <MudSwitch @bind-Value="_draftSerif" Label="Serif typeface" Color="Color.Primary" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _visible = false">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Apply">Apply</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private readonly DialogOptions _options = new() { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, CloseButton = true, CloseOnEscapeKey = true };
    private bool _visible;
    private int _fontSize = 16, _draftFontSize;
    private bool _serif = true, _draftSerif;

    private void Open()
    {
        (_draftFontSize, _draftSerif) = (_fontSize, _serif);
        _visible = true;
    }

    private void Apply()
    {
        (_fontSize, _serif) = (_draftFontSize, _draftSerif);
        _visible = false;
    }
}
