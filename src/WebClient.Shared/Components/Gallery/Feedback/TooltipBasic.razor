<MudStack Row Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Spacing="3">
    <MudTooltip Text="Zoom in">
        <MudIconButton Icon="@Icons.Material.Outlined.ZoomIn" aria-label="Zoom in" />
    </MudTooltip>
    <MudTooltip Text="Zoom out">
        <MudIconButton Icon="@Icons.Material.Outlined.ZoomOut" aria-label="Zoom out" />
    </MudTooltip>
    <MudTooltip Text="Opens the star chart for tonight at 51.5° N">
        <MudButton Variant="Variant.Outlined" Color="Color.Primary">Tonight's sky</MudButton>
    </MudTooltip>
    <MudText>
        The
        <MudTooltip Text="Right ascension: the sky's equivalent of longitude">
            <span tabindex="0" style="border-bottom: 1px dotted currentColor; cursor: help">RA</span>
        </MudTooltip>
        of Vega is 18 h 37 m.
    </MudText>
</MudStack>
