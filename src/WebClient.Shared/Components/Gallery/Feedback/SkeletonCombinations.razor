<EnumMatrix TRow="SkeletonType" TColumn="Animation" Caption="MudSkeleton: SkeletonType × Animation">
    <Cell>
        <div style="display: inline-flex; justify-content: center; width: 9rem">
            <MudSkeleton SkeletonType="@context.Row" Animation="@context.Column" Width="@Width(context.Row)" Height="@Height(context.Row)" />
        </div>
    </Cell>
</EnumMatrix>

@code {
    private static string Width(SkeletonType type) => type == SkeletonType.Circle ? "40px" : "100%";

    private static string? Height(SkeletonType type) => type switch
    {
        SkeletonType.Circle => "40px",
        SkeletonType.Rectangle => "48px",
        _ => null
    };
}
