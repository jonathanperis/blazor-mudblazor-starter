@inject IDialogService DialogService

<MudStack Spacing="2">
    <div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AskAsync">Close the order form</MudButton>
    </div>
    <MudText Typo="Typo.body2" role="status">Last answer: <code>@_answer</code> · @_meaning</MudText>
</MudStack>

@code {
    private string _answer = "none";
    private string _meaning = "Not asked yet.";

    private async Task AskAsync()
    {
        bool? result = await DialogService.ShowMessageBoxAsync(
            "Unsaved order",
            "You have two sourdough loaves and a dozen rolls in an unsaved order.",
            yesText: "Save order", noText: "Discard", cancelText: "Keep editing");

        // ShowMessageBox returns true for yes, false for no, and null when canceled.
        (_answer, _meaning) = result is null ? ("null", "Canceled: still editing.")
            : result.Value ? ("true", "The order was saved.")
            : ("false", "The order was discarded.");
    }
}
