<MudStack Row Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Spacing="6">
    <MudStack AlignItems="AlignItems.Center" Spacing="1">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" aria-label="Loading the catalogue" />
        <MudText Typo="Typo.caption">Indeterminate</MudText>
    </MudStack>
    <MudStack AlignItems="AlignItems.Center" Spacing="1">
        <MudProgressCircular Value="35" Color="Color.Secondary" aria-label="Survey 35 percent complete" />
        <MudText Typo="Typo.caption">Value 35</MudText>
    </MudStack>
    <MudStack AlignItems="AlignItems.Center" Spacing="1">
        <MudProgressCircular Value="72" Color="Color.Primary" Size="Size.Large" aria-label="Reading goal 72 percent complete">
            <MudText Typo="Typo.subtitle2">72%</MudText>
        </MudProgressCircular>
        <MudText Typo="Typo.caption">With a label</MudText>
    </MudStack>
    <MudStack AlignItems="AlignItems.Center" Spacing="1">
        <MudProgressCircular Value="18" Max="24" Color="Color.Tertiary" Size="Size.Large" StrokeWidth="6" Rounded="true" aria-label="18 of 24 books read">
            <MudText Typo="Typo.subtitle2">18/24</MudText>
        </MudProgressCircular>
        <MudText Typo="Typo.caption">Max 24, rounded, thick</MudText>
    </MudStack>
</MudStack>
