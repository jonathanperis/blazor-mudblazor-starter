@page "/components/dialog"
@attribute [ComponentPage("Dialog", GalleryGroup.Feedback, "Dialogs interrupt the page for a decision or a short task that must finish before the user continues. Show them through IDialogService, or inline with a bound Visible.", MudDocs = "dialog", Types = ["MudDialog", "IDialogService", "DialogOptions", "IMudDialogInstance"])]

<ComponentPageFrame Page="GetType()">
    <Example Of="typeof(DialogBasic)" Related="[typeof(DialogNoticeDialog)]" Title="Show a dialog and await its result" Description="ShowAsync renders a dialog component; awaiting Result gives you Canceled and Data." />
    <Example Of="typeof(DialogPositions)" Title="Positions" Description="DialogOptions.Position places the dialog. Corners suit non-blocking panels; center suits decisions." />
    <Example Of="typeof(DialogParametersAndResults)" Related="[typeof(DialogReserveDialog)]" Title="Passing parameters, returning data" Description="DialogParameters<T> sets the dialog's parameters with type checking; DialogResult.Ok(value) returns typed data." />
    <Example Of="typeof(DialogConfirmDelete)" Related="[typeof(DialogDeleteDialog)]" Title="Confirm a deletion" Description="Name the thing being deleted, make the destructive button say what it does, and keep Cancel the safe default." />
    <Example Of="typeof(DialogEditCopy)" Related="[typeof(DialogEditDialog)]" Title="Edit a copy in a form" Description="The dialog edits a copy and validates it; the list changes only when Save returns the copy. Cancel, Escape and the backdrop discard it." />
    <Example Of="typeof(DialogNested)" Related="[typeof(DialogNestedDialog)]" Title="Nested dialogs" Description="A dialog may open another. Each level closes on its own; CancelAll closes the whole stack." />
    <Example Of="typeof(DialogInline)" Title="Inline dialog" Description="A MudDialog declared in the page and bound to Visible needs no separate component, and shares the page's state directly." />
    <Example Of="typeof(DialogPlayground)" Title="Options playground" Description="Combine any DialogOptions, open the dialog to see the effect, and copy the generated options." PreviewClass="example-preview-flush" />
</ComponentPageFrame>
