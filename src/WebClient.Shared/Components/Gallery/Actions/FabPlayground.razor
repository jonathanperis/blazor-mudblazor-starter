<Playground Code="@Code">
    <Preview>
        <MudFab Variant="_variant" Color="_color" Size="_size" StartIcon="@(_icon ? Icons.Material.Outlined.Add : null)"
                Label="@(_extended ? _label : null)" Disabled="_disabled" DropShadow="_dropShadow" aria-label="@(_extended ? null : _label)" />
    </Preview>
    <Controls>
        <MudTextField @bind-Value="_label" Label="Label" Variant="Variant.Outlined" Margin="Margin.Dense" />
        <MudSelect @bind-Value="_variant" Label="Variant" Variant="Variant.Outlined" Margin="Margin.Dense">
            @foreach (var value in Enum.GetValues<Variant>()) { <MudSelectItem Value="value">@value</MudSelectItem> }
        </MudSelect>
        <MudSelect @bind-Value="_color" Label="Color" Variant="Variant.Outlined" Margin="Margin.Dense">
            @foreach (var value in Enum.GetValues<Color>()) { <MudSelectItem Value="value">@value</MudSelectItem> }
        </MudSelect>
        <MudSelect @bind-Value="_size" Label="Size" Variant="Variant.Outlined" Margin="Margin.Dense">
            @foreach (var value in Enum.GetValues<Size>()) { <MudSelectItem Value="value">@value</MudSelectItem> }
        </MudSelect>
        <MudSwitch @bind-Value="_extended" Label="Show label (extended)" Color="Color.Primary" />
        <MudSwitch @bind-Value="_icon" Label="Start icon" Color="Color.Primary" />
        <MudSwitch @bind-Value="_disabled" Label="Disabled" Color="Color.Primary" />
        <MudSwitch @bind-Value="_dropShadow" Label="Drop shadow" Color="Color.Primary" />
    </Controls>
</Playground>

@code {
    private string _label = "New booking";
    private Variant _variant = Variant.Filled;
    private Color _color = Color.Primary;
    private Size _size = Size.Large;
    private bool _extended = true;
    private bool _icon = true;
    private bool _disabled;
    private bool _dropShadow = true;

    // MudFab defaults: Variant.Filled, Color.Default, Size.Large, DropShadow true.
    // A round FAB has no visible text, so the snippet adds an aria-label instead of Label.
    private string Code => Snippet.Element("MudFab",
    [
        ("Variant", Snippet.Enum(_variant, Variant.Filled)),
        ("Color", Snippet.Enum(_color, Color.Default)),
        ("Size", Snippet.Enum(_size, Size.Large)),
        ("StartIcon", _icon ? "@Icons.Material.Outlined.Add" : null),
        ("Label", _extended ? _label : null),
        ("aria-label", _extended ? null : _label),
        ("Disabled", Snippet.Flag(_disabled)),
        ("DropShadow", _dropShadow ? null : "false")
    ]);
}
