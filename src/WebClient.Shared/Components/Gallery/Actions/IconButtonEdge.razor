<MudStack Spacing="3">
    @foreach (var aligned in new[] { false, true })
    {
        <MudStack Spacing="1">
            <MudText Typo="Typo.overline">@(aligned ? "Edge.Start and Edge.End" : "Edge.False (default)")</MudText>
            <MudPaper Outlined Class="px-4 py-1">
                <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                    <MudIconButton Icon="@Icons.Material.Outlined.Menu" Edge="@(aligned ? Edge.Start : Edge.False)" aria-label="Open navigation" />
                    <MudText Typo="Typo.subtitle1" Class="flex-grow-1">Northgate Observatory</MudText>
                    <MudIconButton Icon="@Icons.Material.Outlined.MoreVert" Edge="@(aligned ? Edge.End : Edge.False)" aria-label="More options" />
                </MudStack>
                <MudDivider />
                <MudText Typo="Typo.body2" Class="py-2">Tonight: clear skies after 22:00, seeing 3/5.</MudText>
            </MudPaper>
        </MudStack>
    }
</MudStack>
