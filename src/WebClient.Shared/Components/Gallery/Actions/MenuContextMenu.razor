<MudStack Spacing="3" Style="max-width: 40rem">
    <MudPaper Outlined>
        @if (_plates.Count == 0)
        {
            <MudStack AlignItems="AlignItems.Center" Class="pa-6" Spacing="2">
                <MudText Typo="Typo.body2">All plates were deleted.</MudText>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="Restore">Restore the sample plates</MudButton>
            </MudStack>
        }
        @foreach (var plate in _plates)
        {
            <div class="d-flex align-center gap-3 px-4 py-2" @oncontextmenu="args => OpenAtCursorAsync(args, plate)" @oncontextmenu:preventDefault>
                <MudIcon Icon="@Icons.Material.Outlined.Image" Color="Color.Secondary" />
                <MudStack Spacing="0" Class="flex-grow-1">
                    <MudText Typo="Typo.body1">@plate.Name</MudText>
                    <MudText Typo="Typo.caption">@plate.Detail</MudText>
                </MudStack>
                <MudMenu Icon="@Icons.Material.Outlined.MoreVert" AriaLabel="@($"Actions for {plate.Name}")"
                         AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                    @foreach (var action in Actions)
                    {
                        <MudMenuItem Icon="@action.Icon" IconColor="action.IconColor" Label="@action.Label" OnClick="@(() => Run(action, plate))" />
                    }
                </MudMenu>
            </div>
        }
    </MudPaper>
    <MudText Typo="Typo.body2" role="status">@_status</MudText>
</MudStack>

@* One shared menu for right-clicks. The empty activator keeps it from rendering a blank button. *@
@* The visible ⋮ buttons are the accessible route; this menu only opens at the cursor, so its empty anchor is inert. *@
<div inert>
    <MudMenu @ref="_contextMenu" PositionAtCursor AriaLabel="Plate actions">
        <ActivatorContent></ActivatorContent>
        <ChildContent>
            @if (_target is { } target)
            {
                @foreach (var action in Actions)
                {
                    <MudMenuItem Icon="@action.Icon" IconColor="action.IconColor" Label="@action.Label" OnClick="@(() => Run(action, target))" />
                }
            }
        </ChildContent>
    </MudMenu>
</div>

@code {
    private sealed record Plate(string Name, string Detail);
    private sealed record PlateAction(string Label, string Icon, Color IconColor = Color.Inherit);

    private static readonly Plate[] Samples =
    [
        new("M31, Andromeda galaxy", "12 × 300 s · 14 Sep"),
        new("M42, Orion nebula", "40 × 60 s · 2 Oct"),
        new("NGC 7000, North America nebula", "18 × 240 s · 5 Oct")
    ];

    private static readonly PlateAction[] Actions =
    [
        new("Open full size", Icons.Material.Outlined.OpenInFull),
        new("Download FITS", Icons.Material.Outlined.Download),
        new("Delete", Icons.Material.Outlined.Delete, Color.Error)
    ];

    private readonly List<Plate> _plates = [.. Samples];
    private MudMenu _contextMenu = null!;
    private Plate? _target;
    private string _status = "Use the ⋮ button on a row, or right-click the row.";

    private async Task OpenAtCursorAsync(MouseEventArgs args, Plate plate)
    {
        _target = plate;
        await _contextMenu.OpenMenuAsync(args);
    }

    private void Run(PlateAction action, Plate plate)
    {
        if (action.Label == "Delete") _plates.Remove(plate);
        _status = $"{action.Label}: {plate.Name}.";
    }

    private void Restore()
    {
        _plates.AddRange(Samples);
        _status = "Sample plates restored.";
    }
}
