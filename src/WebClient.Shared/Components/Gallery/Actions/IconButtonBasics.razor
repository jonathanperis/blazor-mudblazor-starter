<MudStack Spacing="3">
    <MudPaper Outlined Class="d-flex align-center gap-2 pa-3">
        <MudIcon Icon="@Icons.Material.Outlined.MenuBook" Color="Color.Secondary" />
        <MudStack Spacing="0" Class="flex-grow-1">
            <MudText Typo="Typo.subtitle2">The Cartographer's Daughter</MudText>
            <MudText Typo="Typo.caption">Paperback · 3 in stock</MudText>
        </MudStack>
        <MudTooltip Text="Edit listing">
            <MudIconButton Icon="@Icons.Material.Outlined.Edit" aria-label="Edit listing" OnClick="@(() => _status = "Editing the listing.")" />
        </MudTooltip>
        <MudTooltip Text="Share link">
            <MudIconButton Icon="@Icons.Material.Outlined.Share" aria-label="Share link" OnClick="@(() => _status = "Link copied to share.")" />
        </MudTooltip>
        <MudTooltip Text="Remove from shelf">
            <MudIconButton Icon="@Icons.Material.Outlined.Delete" Color="Color.Error" aria-label="Remove from shelf" OnClick="@(() => _status = "Removed from the shelf.")" />
        </MudTooltip>
    </MudPaper>
    <MudText Typo="Typo.body2" role="status">@_status</MudText>
</MudStack>

@code {
    private string _status = "Hover or focus an icon to read its name.";
}
