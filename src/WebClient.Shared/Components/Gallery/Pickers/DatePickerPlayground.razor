<Playground Code="@Code">
    <Preview>
        <div style="min-width: 16rem">
            <MudDatePicker @bind-Date="_date" Label="@_label" Variant="_variant" PickerVariant="_pickerVariant" Color="_color"
                           Orientation="_orientation" OpenTo="_openTo" ShowToolbar="_showToolbar" ShowWeekNumbers="_showWeekNumbers"
                           Clearable="_clearable" Editable="_editable" Disabled="_disabled" />
        </div>
    </Preview>
    <Controls>
        <MudTextField @bind-Value="_label" Label="Label" Variant="Variant.Outlined" Margin="Margin.Dense" />
        <MudSelect @bind-Value="_variant" Label="Variant" Variant="Variant.Outlined" Margin="Margin.Dense">
            @foreach (var value in Enum.GetValues<Variant>()) { <MudSelectItem Value="value">@value</MudSelectItem> }
        </MudSelect>
        <MudSelect @bind-Value="_pickerVariant" Label="Picker variant" Variant="Variant.Outlined" Margin="Margin.Dense">
            @foreach (var value in Enum.GetValues<PickerVariant>()) { <MudSelectItem Value="value">@value</MudSelectItem> }
        </MudSelect>
        <MudSelect @bind-Value="_color" Label="Color" Variant="Variant.Outlined" Margin="Margin.Dense">
            @foreach (var value in Enum.GetValues<Color>()) { <MudSelectItem Value="value">@value</MudSelectItem> }
        </MudSelect>
        <MudSelect @bind-Value="_orientation" Label="Orientation" Variant="Variant.Outlined" Margin="Margin.Dense">
            @foreach (var value in Enum.GetValues<Orientation>()) { <MudSelectItem Value="value">@value</MudSelectItem> }
        </MudSelect>
        <MudSelect @bind-Value="_openTo" Label="Open to" Variant="Variant.Outlined" Margin="Margin.Dense">
            @foreach (var value in new[] { OpenTo.Date, OpenTo.Month, OpenTo.Year }) { <MudSelectItem Value="value">@value</MudSelectItem> }
        </MudSelect>
        <MudSwitch @bind-Value="_showToolbar" Label="Toolbar" Color="Color.Primary" />
        <MudSwitch @bind-Value="_showWeekNumbers" Label="Week numbers" Color="Color.Primary" />
        <MudSwitch @bind-Value="_clearable" Label="Clearable" Color="Color.Primary" />
        <MudSwitch @bind-Value="_editable" Label="Editable" Color="Color.Primary" />
        <MudSwitch @bind-Value="_disabled" Label="Disabled" Color="Color.Primary" />
    </Controls>
</Playground>

@code {
    private DateTime? _date = new DateTime(2026, 11, 14);
    private string _label = "Opening night";
    private Variant _variant = Variant.Outlined;
    private PickerVariant _pickerVariant = PickerVariant.Inline;
    private Color _color = Color.Primary;
    private Orientation _orientation = Orientation.Portrait;
    private OpenTo _openTo = OpenTo.Date;
    private bool _showToolbar = true;
    private bool _showWeekNumbers;
    private bool _clearable;
    private bool _editable;
    private bool _disabled;

    // MudDatePicker defaults: Variant.Text, PickerVariant.Inline, Color.Primary, Orientation.Portrait, OpenTo.Date, toolbar shown.
    private string Code => Snippet.Element("MudDatePicker",
    [
        ("@bind-Date", "_date"),
        ("Label", _label),
        ("Variant", Snippet.Enum(_variant, Variant.Text)),
        ("PickerVariant", Snippet.Enum(_pickerVariant, PickerVariant.Inline)),
        ("Color", Snippet.Enum(_color, Color.Primary)),
        ("Orientation", Snippet.Enum(_orientation, Orientation.Portrait)),
        ("OpenTo", Snippet.Enum(_openTo, OpenTo.Date)),
        ("ShowToolbar", _showToolbar ? null : "false"),
        ("ShowWeekNumbers", Snippet.Flag(_showWeekNumbers)),
        ("Clearable", Snippet.Flag(_clearable)),
        ("Editable", Snippet.Flag(_editable)),
        ("Disabled", Snippet.Flag(_disabled))
    ]);
}
