<MudStack Spacing="3" Style="max-width: 36rem">
    <MudFileUpload T="IReadOnlyList<IBrowserFile>" @ref="_upload" @bind-Files="_attachments" AppendMultipleFiles="true" MaximumFileCount="20">
        <CustomContent>
            <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.AttachFile" OnClick="@context.OpenFilePickerAsync">Add attachments</MudButton>
                <MudButton Variant="Variant.Text" Color="Color.Error" Disabled="@(Count == 0)" OnClick="@context.ClearAsync">Remove all</MudButton>
            </MudStack>
        </CustomContent>
        <SelectedTemplate />
    </MudFileUpload>

    @if (Count == 0)
    {
        <MudText Typo="Typo.body2" role="status">No attachments yet. Each selection is added to the list.</MudText>
    }
    else
    {
        <MudText Typo="Typo.body2" role="status">@Count file(s), @FormatSize(_attachments!.Sum(file => file.Size)) in total</MudText>
        <MudPaper Outlined="true">
            <MudList T="IBrowserFile" Dense="true" ReadOnly="true">
                @foreach (var file in _attachments!)
                {
                    <MudListItem @key="file" Icon="@Icons.Material.Outlined.InsertDriveFile">
                        <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.body2">@file.Name <span class="mud-text-secondary">· @FormatSize(file.Size)</span></MudText>
                            <MudIconButton Icon="@Icons.Material.Outlined.Close" Size="Size.Small" aria-label="@($"Remove {file.Name}")"
                                           OnClick="@(() => _upload.RemoveFileAsync(file))" />
                        </MudStack>
                    </MudListItem>
                }
            </MudList>
        </MudPaper>
    }
</MudStack>

@code {
    private MudFileUpload<IReadOnlyList<IBrowserFile>> _upload = null!;
    private IReadOnlyList<IBrowserFile>? _attachments;

    private int Count => _attachments?.Count ?? 0;

    private static string FormatSize(long bytes) => bytes < 1024 * 1024 ? $"{bytes / 1024.0:0.#} KB" : $"{bytes / (1024.0 * 1024):0.#} MB";
}
