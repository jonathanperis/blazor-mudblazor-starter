<MudStack Spacing="3" Style="max-width: 24rem">
    <MudDatePicker @bind-Date="_night" Label="Stargazing night" Variant="Variant.Outlined"
                   MinDate="_opens" MaxDate="_closes" StartMonth="_opens"
                   IsDateDisabledFunc="IsClosed" AdditionalDateClassesFunc="MeteorShowerClass"
                   HelperText="November only. Closed on Mondays and on the full moon." />
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
        The Leonid meteor shower peaks on 17 and 18 November; those nights are shaded in the calendar.
    </MudAlert>
</MudStack>

@code {
    private readonly DateTime _opens = new(2026, 11, 1);
    private readonly DateTime _closes = new(2026, 11, 30);
    private readonly DateTime _fullMoon = new(2026, 11, 24);
    private DateTime? _night;

    private bool IsClosed(DateTime date) => date.DayOfWeek == DayOfWeek.Monday || date == _fullMoon;

    // Extra classes style a day without changing whether it can be picked.
    private string MeteorShowerClass(DateTime date) => date.Month == 11 && date.Day is 17 or 18 ? "mud-theme-secondary" : "";
}
