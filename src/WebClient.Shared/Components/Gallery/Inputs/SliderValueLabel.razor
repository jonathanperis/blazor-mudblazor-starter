<MudStack Spacing="6" Class="pt-6">
    <MudSlider @bind-Value="_budget" Min="0m" Max="500m" Step="10m" ValueLabel="true" ValueLabelFormat="C0" Culture="_culture">
        Equipment budget: @_budget.ToString("C0", _culture)
    </MudSlider>
    <MudSlider @bind-Value="_humidity" Min="0" Max="1" Step="0.05" ValueLabel="true" ValueLabelFormat="P0" Color="Color.Secondary">
        Dew warning threshold
    </MudSlider>
    <MudSlider @bind-Value="_hour" Min="18" Max="30" ValueLabel="true" Color="Color.Tertiary">
        <ValueLabelContent>@($"{context.Value % 24:00}:00")</ValueLabelContent>
        <ChildContent>Session ends at @($"{_hour % 24:00}:00")</ChildContent>
    </MudSlider>
</MudStack>

@code {
    private readonly CultureInfo _culture = CultureInfo.GetCultureInfo("en-GB");
    private decimal _budget = 180m;
    private double _humidity = 0.85;
    private int _hour = 26;
}
