<MudGrid Spacing="4">
    <MudItem xs="12" sm="6">
        <MudField Label="Order reference" Variant="Variant.Outlined"
                  Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Outlined.ContentCopy"
                  OnAdornmentClick="Copy" AdornmentAriaLabel="Copy order reference">ORD-20481</MudField>
    </MudItem>
    <MudItem xs="12" sm="6">
        <MudField Label="Delivery" Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.LocalShipping"
                  AdornmentColor="Color.Success" HelperText="Courier: Riverside Cycles">Thursday, 14:00–16:00</MudField>
    </MudItem>
    <MudItem xs="12" sm="6">
        <MudField Label="Payment" Variant="Variant.Outlined" Error="true" ErrorText="The card was declined. Update your payment method."
                  Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Outlined.ErrorOutline" AdornmentColor="Color.Error">Card ending 4417</MudField>
    </MudItem>
    <MudItem xs="12" sm="6">
        <MudField Label="Loyalty points" Variant="Variant.Outlined" Disabled="true" Adornment="Adornment.End" AdornmentText="pts">
            Paused while your account is reviewed
        </MudField>
    </MudItem>
    <MudItem xs="12">
        <MudText Typo="Typo.body2" role="status">@_status</MudText>
    </MudItem>
</MudGrid>

@code {
    private string _status = "";

    private void Copy() => _status = "Order reference ORD-20481 copied.";
}
