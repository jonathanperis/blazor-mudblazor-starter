<MudGrid Spacing="4">
    <MudItem xs="12" md="4">
        <MudText Typo="Typo.subtitle2" HtmlTag="h3" id="filling-label">One option disabled</MudText>
        <MudRadioGroup @bind-Value="_filling" aria-labelledby="filling-label">
            <MudRadio Value="@("Apple")" Color="Color.Primary">Apple</MudRadio>
            <MudRadio Value="@("Cherry")" Color="Color.Primary" Disabled="true">Cherry (sold out)</MudRadio>
            <MudRadio Value="@("Plum")" Color="Color.Primary">Plum</MudRadio>
        </MudRadioGroup>
    </MudItem>
    <MudItem xs="12" md="4">
        <MudText Typo="Typo.subtitle2" HtmlTag="h3" id="locked-label">Whole group read-only</MudText>
        <MudRadioGroup T="string" Value="@("Rye")" ReadOnly="true" aria-labelledby="locked-label">
            <MudRadio Value="@("Wheat")" Color="Color.Primary">Wheat</MudRadio>
            <MudRadio Value="@("Rye")" Color="Color.Primary">Rye</MudRadio>
        </MudRadioGroup>
    </MudItem>
    <MudItem xs="12" md="4">
        <MudForm @ref="_form">
            <MudText Typo="Typo.subtitle2" HtmlTag="h3" id="size-label">Required</MudText>
            <MudRadioGroup @bind-Value="_size" Required="true" RequiredError="Choose a cake size" aria-labelledby="size-label">
                <MudRadio Value="@("6 inch")" Color="Color.Primary">6 inch</MudRadio>
                <MudRadio Value="@("9 inch")" Color="Color.Primary">9 inch</MudRadio>
            </MudRadioGroup>
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Class="mt-2" Style="align-self: flex-start" OnClick="() => _form.ValidateAsync()">Validate</MudButton>
        </MudForm>
    </MudItem>
</MudGrid>

@code {
    private MudForm _form = null!;
    private string _filling = "Apple";
    private string? _size;
}
