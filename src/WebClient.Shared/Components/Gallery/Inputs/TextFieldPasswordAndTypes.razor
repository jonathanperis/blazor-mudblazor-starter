<MudGrid Spacing="4">
    <MudItem xs="12" sm="6">
        <MudTextField @bind-Value="_password" Label="Password" Variant="Variant.Outlined" HelperText="At least 12 characters"
                      InputType="@(_reveal ? InputType.Text : InputType.Password)"
                      Adornment="Adornment.End" AdornmentIcon="@(_reveal ? Icons.Material.Outlined.VisibilityOff : Icons.Material.Outlined.Visibility)"
                      OnAdornmentClick="() => _reveal = !_reveal" AdornmentAriaLabel="@(_reveal ? "Hide password" : "Show password")" />
    </MudItem>
    <MudItem xs="12" sm="6">
        <MudTextField @bind-Value="_email" Label="Email" Variant="Variant.Outlined" InputType="InputType.Email"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Email" />
    </MudItem>
    <MudItem xs="12" sm="6">
        <MudTextField @bind-Value="_phone" Label="Phone" Variant="Variant.Outlined" InputType="InputType.Telephone"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Phone" />
    </MudItem>
    <MudItem xs="12" sm="6">
        <MudTextField @bind-Value="_search" Label="Search" Variant="Variant.Outlined" InputType="InputType.Search"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search" />
    </MudItem>
</MudGrid>

@code {
    private string _password = "lanterns-at-dusk";
    private bool _reveal;
    private string _email = "orders@harbourbooks.example";
    private string _phone = "+44 20 7946 0018";
    private string _search = "";
}
