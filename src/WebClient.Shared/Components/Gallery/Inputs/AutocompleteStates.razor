<MudForm>
    <MudGrid Spacing="4">
        <MudItem xs="12" sm="6">
            <MudAutocomplete T="string" @bind-Value="_site" SearchFunc="Search" Label="Observing site" Variant="Variant.Outlined"
                             Required="true" RequiredError="Choose where you will observe" ResetValueOnEmptyText="true" />
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudAutocomplete T="string" @bind-Value="_backup" SearchFunc="Search" Label="Backup site" Variant="Variant.Outlined"
                             Validation="@(new Func<string, string?>(DifferentFromMain))" HelperText="Must differ from the main site" />
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudAutocomplete T="string" Value="@("Ridge station")" SearchFunc="Search" Label="Disabled" Variant="Variant.Outlined" Disabled="true" />
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudAutocomplete T="string" Value="@("Valley lab")" SearchFunc="Search" Label="Read-only" Variant="Variant.Outlined" ReadOnly="true" />
        </MudItem>
    </MudGrid>
</MudForm>

@code {
    private string? _site = "Plateau array";
    private string? _backup = "Plateau array";

    private readonly string[] _sites = ["Ridge station", "Valley lab", "Plateau array", "Coastal dome"];

    private Task<IEnumerable<string>> Search(string? text, CancellationToken token) =>
        Task.FromResult(_sites.Where(site => site.Contains(text ?? "", StringComparison.OrdinalIgnoreCase)));

    private string? DifferentFromMain(string backup) => backup == _site ? "Pick a different site from the main one" : null;
}
