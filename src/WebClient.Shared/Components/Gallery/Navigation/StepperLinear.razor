<MudPaper Outlined="true" Class="pa-4">
    <MudStepper ShowResetButton="true">
        <ChildContent>
            <MudStep Title="Choose a night" SecondaryText="Clear skies forecast">
                <MudText Typo="Typo.body2">Friday 17 October has the darkest sky this month: new moon and low humidity.</MudText>
            </MudStep>
            <MudStep Title="Choose a telescope">
                <MudText Typo="Typo.body2">The 0.6 metre reflector suits galaxies; the refractor suits the planets.</MudText>
            </MudStep>
            <MudStep Title="Confirm">
                <MudText Typo="Typo.body2">Two seats, 22:00 to 23:30, at Ridgeline Observatory.</MudText>
            </MudStep>
        </ChildContent>
        <CompletedContent>
            <MudAlert Severity="Severity.Success" Variant="Variant.Outlined">Booked. Bring warm clothes: the dome is not heated.</MudAlert>
        </CompletedContent>
    </MudStepper>
</MudPaper>
