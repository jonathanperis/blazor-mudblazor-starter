<MudPaper Outlined="true" Class="pa-4" Style="max-width: 32rem">
    <MudStepper Vertical="true">
        <MudStep Title="Feed the starter" SecondaryText="The night before">
            <MudText Typo="Typo.body2">Mix 50 g starter with 50 g flour and 50 g water. Leave it somewhere warm.</MudText>
        </MudStep>
        <MudStep Title="Mix and rest" SecondaryText="9:00">
            <MudText Typo="Typo.body2">Combine flour and water, rest for an hour, then add the starter and salt.</MudText>
        </MudStep>
        <MudStep Title="Fold" SecondaryText="10:00 to 12:00">
            <MudText Typo="Typo.body2">Four sets of folds, thirty minutes apart.</MudText>
        </MudStep>
        <MudStep Title="Shape and prove" SecondaryText="Overnight, in the cold">
            <MudText Typo="Typo.body2">Shape a tight round, place it in a floured basket, cover and refrigerate.</MudText>
        </MudStep>
    </MudStepper>
</MudPaper>
