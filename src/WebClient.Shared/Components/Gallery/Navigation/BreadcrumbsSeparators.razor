<MudStack Spacing="1">
    @foreach (var separator in new[] { "/", ">", "·", "→" })
    {
        <MudBreadcrumbs Items="_trail" Separator="@separator" />
    }
    <MudBreadcrumbs Items="_trail">
        <SeparatorTemplate>
            <MudIcon Icon="@Icons.Material.Outlined.ChevronRight" Size="Size.Small" />
        </SeparatorTemplate>
    </MudBreadcrumbs>
</MudStack>

@code {
    private readonly List<BreadcrumbItem> _trail =
    [
        new("Archive", href: "components/breadcrumbs"),
        new("Maps", href: "components/breadcrumbs"),
        new("Coastal survey, 1894", href: null, disabled: true)
    ];
}
