<MudPaper Outlined="true" Class="overflow-hidden">
    <MudAppBar Fixed="false" Elevation="0">
        <MudIconButton Icon="@Icons.Material.Outlined.Menu" Color="Color.Inherit" Edge="Edge.Start" aria-label="Open navigation" />
        <MudText Typo="Typo.h6" HtmlTag="span" Class="ml-2">Harbour Lights Bookshop</MudText>
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Outlined.Search" Color="Color.Inherit" aria-label="Search the catalogue" />
        <MudIconButton Icon="@Icons.Material.Outlined.ShoppingBag" Color="Color.Inherit" Edge="Edge.End" aria-label="Open the basket" />
    </MudAppBar>
    <MudText Typo="Typo.body2" Class="pa-4">New arrivals, staff picks and the autumn reading list scroll beneath the bar.</MudText>
</MudPaper>
