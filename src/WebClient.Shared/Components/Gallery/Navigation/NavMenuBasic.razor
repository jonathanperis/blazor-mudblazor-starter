@* Base-relative addresses (no leading slash) keep the links working when the app is hosted below the site root. *@
<MudPaper Outlined="true" MaxWidth="20rem" Class="py-2">
    <MudNavMenu Color="Color.Primary" Bordered="true">
        <MudNavLink Href="components/app-bar" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.WebAsset">App bar</MudNavLink>
        <MudNavLink Href="components/drawer" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.ViewSidebar">Drawer</MudNavLink>
        <MudNavLink Href="components/nav-menu" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Menu">Nav menu</MudNavLink>
        <MudNavLink Href="components/tabs" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Tab">Tabs</MudNavLink>
        <MudNavLink Href="https://mudblazor.com/components/navmenu" Target="_blank" Rel="noopener noreferrer" Icon="@Icons.Material.Outlined.OpenInNew">MudBlazor reference</MudNavLink>
    </MudNavMenu>
</MudPaper>
