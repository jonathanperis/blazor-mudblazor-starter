<MudPaper Outlined="true" Height="18rem" Class="overflow-hidden" Style="position: relative">
    <MudDrawerContainer Class="mud-height-full">
        <MudDrawer @bind-Open="_open" Variant="DrawerVariant.Persistent" Fixed="false" Elevation="0" Class="border-r border-solid mud-border-lines-default">
            <MudDrawerHeader Dense="true">
                <MudText Typo="Typo.subtitle1" HtmlTag="span">Reading room</MudText>
            </MudDrawerHeader>
            <MudNavMenu aria-label="Persistent drawer navigation">
                @foreach (var (section, icon) in Sections)
                {
                    <MudNavLink Icon="@icon" OnClick="() => _section = section">@section</MudNavLink>
                }
            </MudNavMenu>
        </MudDrawer>
        <div class="pa-4">
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Menu" OnClick="() => _open = !_open"
                       aria-expanded="@(_open ? "true" : "false")">@(_open ? "Close the drawer" : "Open the drawer")</MudButton>
            <MudText Typo="Typo.h6" HtmlTag="h3" Class="mt-4">@_section</MudText>
            <MudText Typo="Typo.body2">The persistent drawer pushes this column aside instead of covering it.</MudText>
        </div>
    </MudDrawerContainer>
</MudPaper>

@code {
    private bool _open = true;
    private string _section = "Catalogue";

    private static readonly (string Section, string Icon)[] Sections =
    [
        ("Catalogue", Icons.Material.Outlined.MenuBook),
        ("Loans", Icons.Material.Outlined.SwapHoriz),
        ("Reservations", Icons.Material.Outlined.BookmarkBorder)
    ];
}
