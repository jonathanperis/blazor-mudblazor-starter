<MudStack AlignItems="AlignItems.Center" Spacing="3">
    <MudSwipeArea OnSwipeEnd="OnSwipeEnd" Style="width: min(100%, 22rem); user-select: none">
        <MudPaper Outlined="true" Class="pa-5">
            <MudText Typo="Typo.overline" HtmlTag="p">Target @(_index + 1) of @Targets.Length</MudText>
            <MudText Typo="Typo.h6" HtmlTag="h3">@Targets[_index].Name</MudText>
            <MudText Typo="Typo.body2">@Targets[_index].Note</MudText>
        </MudPaper>
    </MudSwipeArea>
    <MudStack Row="true" Spacing="2">
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.ChevronLeft" Disabled="_index == 0" OnClick="() => Move(-1)">Previous</MudButton>
        <MudButton Variant="Variant.Outlined" EndIcon="@Icons.Material.Outlined.ChevronRight" Disabled="_index == Targets.Length - 1" OnClick="() => Move(1)">Next</MudButton>
    </MudStack>
</MudStack>

@code {
    private static readonly (string Name, string Note)[] Targets =
    [
        ("Andromeda Galaxy", "Naked-eye smudge in a dark sky; fills the eyepiece at low power."),
        ("Ring Nebula", "A small smoke ring in Lyra. Use the 0.6 metre reflector."),
        ("Double Cluster", "Two open clusters in one field. Best in binoculars."),
        ("Saturn", "Rings near their widest this year. High magnification.")
    ];

    private int _index;

    // Swiping right to left brings in the next card, as on a phone.
    private void OnSwipeEnd(SwipeEventArgs args)
    {
        if (args.SwipeDirection == SwipeDirection.RightToLeft) Move(1);
        else if (args.SwipeDirection == SwipeDirection.LeftToRight) Move(-1);
    }

    private void Move(int step) => _index = Math.Clamp(_index + step, 0, Targets.Length - 1);
}
