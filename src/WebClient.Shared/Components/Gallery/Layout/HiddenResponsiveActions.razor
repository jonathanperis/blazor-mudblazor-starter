<MudPaper Outlined="true">
    <MudToolBar>
        <MudText Typo="Typo.subtitle1" HtmlTag="span">Field log, 9 October</MudText>
        <MudSpacer />
        <MudHidden Breakpoint="Breakpoint.SmAndDown">
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.Share">Share</MudButton>
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.Download">Export</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Edit">Edit</MudButton>
        </MudHidden>
        <MudHidden Breakpoint="Breakpoint.MdAndUp">
            <MudIconButton Icon="@Icons.Material.Outlined.Share" aria-label="Share" />
            <MudIconButton Icon="@Icons.Material.Outlined.Download" aria-label="Export" />
            <MudIconButton Icon="@Icons.Material.Outlined.Edit" Color="Color.Primary" aria-label="Edit" />
        </MudHidden>
    </MudToolBar>
</MudPaper>
