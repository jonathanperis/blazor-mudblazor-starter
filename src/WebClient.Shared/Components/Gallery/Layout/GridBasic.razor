<MudGrid>
    <MudItem xs="12">
        <MudPaper Outlined="true" Class="pa-3 text-center">xs="12"</MudPaper>
    </MudItem>
    @for (var i = 0; i < 2; i++)
    {
        <MudItem xs="6">
            <MudPaper Outlined="true" Class="pa-3 text-center">xs="6"</MudPaper>
        </MudItem>
    }
    @for (var i = 0; i < 3; i++)
    {
        <MudItem xs="4">
            <MudPaper Outlined="true" Class="pa-3 text-center">xs="4"</MudPaper>
        </MudItem>
    }
    <MudItem xs="3">
        <MudPaper Outlined="true" Class="pa-3 text-center">xs="3"</MudPaper>
    </MudItem>
    <MudItem xs="9">
        <MudPaper Outlined="true" Class="pa-3 text-center">xs="9"</MudPaper>
    </MudItem>
</MudGrid>
