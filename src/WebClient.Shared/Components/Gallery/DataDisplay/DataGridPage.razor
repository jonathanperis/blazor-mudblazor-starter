@page "/components/data-grid"
@attribute [ComponentPage("Data grid", GalleryGroup.DataDisplay, "A column-driven grid: declare each column once and the grid sorts, filters, groups, aggregates, edits, resizes and virtualizes for you. Choose it over the table when people need to explore data, not just read it.", MudDocs = "datagrid", Types = ["MudDataGrid", "PropertyColumn", "TemplateColumn", "HierarchyColumn", "SelectColumn", "MudDataGridPager"])]

<ComponentPageFrame Page="GetType()">
    <Example Of="typeof(DataGridColumns)" Title="Property and template columns" Description="PropertyColumn reads a property and knows its type, so it can sort, filter and format it. TemplateColumn renders anything; give it a SortBy when it should still sort." PreviewClass="example-preview-flush" />
    <Example Of="typeof(DataGridSorting)" Title="Sorting" Description="SortMode chooses between no sorting, one column at a time, or several, ranked in the order you click them. SortBy gives a template column a sort key: Altitude sorts by metres, not by its label." PreviewClass="example-preview-flush" />
    <Example Of="typeof(DataGridFiltering)" Title="Filter modes and quick filter" Description="Simple opens one filter panel for the grid, ColumnFilterMenu puts a menu on each header, and ColumnFilterRow adds a row of inputs. QuickFilter is your own predicate, usually fed by a search box." PreviewClass="example-preview-flush" />
    <Example Of="typeof(DataGridGroupingAggregates)" Title="Grouping and aggregates" Description="Grouping on a column gathers rows under collapsible headers. AggregateDefinition adds a footer per group and for the whole grid: built-in Avg, Sum, Min, Max and Count, or a custom function." PreviewClass="example-preview-flush" />
    <Example Of="typeof(DataGridHierarchy)" Title="Child rows" Description="HierarchyColumn adds an expand button; ChildRowContent renders below the row. ButtonDisabledFunc and InitiallyExpandedFunc decide per row, ExpandSingleRow closes the others." PreviewClass="example-preview-flush" />
    <Example Of="typeof(DataGridEditing)" Title="Cell, inline and form editing" Description="Form and Inline edit a copy of the row and apply it only when you save; CommittedItemChanges can refuse with KeepOpen. Cell mode writes straight to the item as you type." PreviewClass="example-preview-flush" />
    <Example Of="typeof(DataGridSelection)" Title="Selection" Description="SelectColumn adds checkboxes with a select-all header. DisabledFunc keeps some rows out of the selection, and AriaLabelFunc names each checkbox for screen readers." PreviewClass="example-preview-flush" />
    <Example Of="typeof(DataGridColumnOptions)" Title="Resize, reorder and hide columns" Description="Drag a header edge to resize and a header to move it; Title stays pinned and Shelf keeps its width. Hideable lists columns in the column menu, and binding Hidden lets your own controls show or hide a column." PreviewClass="example-preview-flush" />
    <Example Of="typeof(DataGridStickyColumns)" Title="Sticky columns" Description="StickyLeft and StickyRight pin a column while the rest scroll horizontally, so the row name and its actions never leave the screen." PreviewClass="example-preview-flush" />
    <Example Of="typeof(DataGridVirtualization)" Title="Virtualization" Description="With Virtualize, a fixed Height and a FixedHeader, only the rows in view are rendered. Ten thousand readings scroll as smoothly as ten." PreviewClass="example-preview-flush" />
    <Example Of="typeof(DataGridServerData)" Title="Server-side data with cancellation" Description="ServerData receives the page, sort and filters with a CancellationToken. The grid cancels the previous request when a new one starts, so stale pages never land." PreviewClass="example-preview-flush" />
    <Example Of="typeof(DataGridPlayground)" Title="Playground" Description="Toggle the grid's appearance and features; the markup lists only the values that differ from the defaults." PreviewClass="example-preview-flush" />
</ComponentPageFrame>
