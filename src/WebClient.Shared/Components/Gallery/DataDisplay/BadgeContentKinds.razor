<MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.End" Spacing="10" Class="pt-3">
    <MudStack AlignItems="AlignItems.Center" Spacing="2">
        <MudBadge Content="3" Color="Color.Primary" BadgeAriaLabel="3 unread messages">
            <MudIcon Icon="@Icons.Material.Outlined.Mail" Size="Size.Large" />
        </MudBadge>
        <MudText Typo="Typo.caption">Content="3"</MudText>
    </MudStack>
    <MudStack AlignItems="AlignItems.Center" Spacing="2">
        <MudBadge Content="128" Max="99" Color="Color.Primary" BadgeAriaLabel="128 orders waiting">
            <MudIcon Icon="@Icons.Material.Outlined.Inventory2" Size="Size.Large" />
        </MudBadge>
        <MudText Typo="Typo.caption">128 with Max="99"</MudText>
    </MudStack>
    <MudStack AlignItems="AlignItems.Center" Spacing="2">
        <MudBadge Content="@("New")" Color="Color.Secondary" BadgeAriaLabel="New features">
            <MudIcon Icon="@Icons.Material.Outlined.Campaign" Size="Size.Large" />
        </MudBadge>
        <MudText Typo="Typo.caption">A short string</MudText>
    </MudStack>
    <MudStack AlignItems="AlignItems.Center" Spacing="2">
        <MudBadge Dot="true" Color="Color.Error" BadgeAriaLabel="Updates available">
            <MudIcon Icon="@Icons.Material.Outlined.SystemUpdate" Size="Size.Large" />
        </MudBadge>
        <MudText Typo="Typo.caption">Dot</MudText>
    </MudStack>
    <MudStack AlignItems="AlignItems.Center" Spacing="2">
        <MudBadge Icon="@Icons.Material.Filled.Lock" Color="Color.Dark" BadgeAriaLabel="Locked">
            <MudIcon Icon="@Icons.Material.Outlined.Folder" Size="Size.Large" />
        </MudBadge>
        <MudText Typo="Typo.caption">Icon</MudText>
    </MudStack>
    <MudStack AlignItems="AlignItems.Center" Spacing="2">
        <MudBadge Content="5" Color="Color.Warning" Elevation="4" BadgeAriaLabel="5 alerts">
            <MudIcon Icon="@Icons.Material.Outlined.NotificationsActive" Size="Size.Large" />
        </MudBadge>
        <MudText Typo="Typo.caption">Elevation="4"</MudText>
    </MudStack>
</MudStack>
