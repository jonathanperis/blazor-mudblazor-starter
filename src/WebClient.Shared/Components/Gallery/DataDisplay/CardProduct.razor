<MudCard Outlined="true" Style="max-width: 20rem">
    <MudCardMedia Image="@Knot" Height="170" Title="Two braided cardamom buns dusted with sugar" />
    <MudCardContent>
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start">
            <MudText Typo="Typo.h6" HtmlTag="h3">Cardamom knot</MudText>
            <MudText Typo="Typo.h6" HtmlTag="p" Color="Color.Primary">€ 2.40</MudText>
        </MudStack>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-2">
            <MudRating SelectedValue="4" ReadOnly="true" Size="Size.Small" Color="Color.Tertiary" />
            <MudText Typo="Typo.caption" Class="mud-text-secondary">4 out of 5 · 86 reviews</MudText>
        </MudStack>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">Brioche dough twisted with butter, sugar and freshly ground cardamom. Baked at 6:30.</MudText>
        <MudStack Row="true" Spacing="1" Class="mt-3">
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Icon="@Icons.Material.Outlined.Spa">Vegetarian</MudChip>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Icon="@Icons.Material.Outlined.Info">Contains milk</MudChip>
        </MudStack>
    </MudCardContent>
    <MudCardActions Class="d-flex justify-space-between">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="0">
            <MudIconButton Icon="@Icons.Material.Outlined.Remove" aria-label="One fewer" Size="Size.Small" Disabled="@(_quantity == 1)" OnClick="() => _quantity--" />
            <MudText Typo="Typo.subtitle2" Class="px-2" aria-live="polite">@_quantity</MudText>
            <MudIconButton Icon="@Icons.Material.Outlined.Add" aria-label="One more" Size="Size.Small" Disabled="@(_quantity == 12)" OnClick="() => _quantity++" />
        </MudStack>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.ShoppingBasket">Add · € @Total</MudButton>
    </MudCardActions>
</MudCard>

@code {
    private int _quantity = 2;

    private string Total => (_quantity * 2.40m).ToString("0.00", CultureInfo.InvariantCulture);

    private static readonly string Knot = "data:image/svg+xml;utf8," + Uri.EscapeDataString(
        "<svg xmlns='http://www.w3.org/2000/svg' width='400' height='220' viewBox='0 0 400 220'>" +
        "<rect width='400' height='220' fill='#EFE6D6'/><rect y='150' width='400' height='70' fill='#C9B79A'/>" +
        "<ellipse cx='150' cy='135' rx='70' ry='42' fill='#C68A4A'/><path d='M95 130q55-40 110 0M100 145q50-30 100 0' stroke='#8C5A2B' stroke-width='6' fill='none'/>" +
        "<ellipse cx='270' cy='140' rx='60' ry='36' fill='#D29A58'/><path d='M222 136q48-34 96 0' stroke='#8C5A2B' stroke-width='6' fill='none'/>" +
        "<g fill='#FBFAF6'><circle cx='130' cy='118' r='2'/><circle cx='170' cy='112' r='2'/><circle cx='260' cy='124' r='2'/><circle cx='290' cy='130' r='2'/></g></svg>");
}
