<MudStack Spacing="5">
    <div>
        <MudText Typo="Typo.overline" HtmlTag="p" Class="mb-2">Vertical with FlexItem</MudText>
        <MudPaper Outlined="true" Class="d-flex flex-wrap align-center gap-4 px-4 py-3">
            <MudStack Spacing="0">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Distance</MudText>
                <MudText Typo="Typo.h6" HtmlTag="p">14.2 km</MudText>
            </MudStack>
            <MudDivider Vertical="true" FlexItem="true" />
            <MudStack Spacing="0">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Stops</MudText>
                <MudText Typo="Typo.h6" HtmlTag="p">11</MudText>
            </MudStack>
            <MudDivider Vertical="true" FlexItem="true" />
            <MudStack Spacing="0">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Journey time</MudText>
                <MudText Typo="Typo.h6" HtmlTag="p">21 min</MudText>
            </MudStack>
        </MudPaper>
    </div>
    <div>
        <MudText Typo="Typo.overline" HtmlTag="p" Class="mb-2">In a toolbar of actions</MudText>
        <MudPaper Outlined="true" Class="d-flex align-center gap-1 px-2 py-1" Style="width: fit-content">
            <MudIconButton Icon="@Icons.Material.Outlined.FormatBold" aria-label="Bold" Size="Size.Small" />
            <MudIconButton Icon="@Icons.Material.Outlined.FormatItalic" aria-label="Italic" Size="Size.Small" />
            <MudDivider Vertical="true" FlexItem="true" Class="mx-1" />
            <MudIconButton Icon="@Icons.Material.Outlined.FormatListBulleted" aria-label="Bulleted list" Size="Size.Small" />
            <MudIconButton Icon="@Icons.Material.Outlined.FormatListNumbered" aria-label="Numbered list" Size="Size.Small" />
            <MudDivider Vertical="true" FlexItem="true" Class="mx-1" />
            <MudIconButton Icon="@Icons.Material.Outlined.Link" aria-label="Insert link" Size="Size.Small" />
        </MudPaper>
    </div>
    <div>
        <MudText Typo="Typo.overline" HtmlTag="p" Class="mb-2">Vertical without FlexItem: the rule collapses</MudText>
        <MudPaper Outlined="true" Class="d-flex align-center gap-4 px-4 py-3" Style="width: fit-content">
            <MudText>Arrivals</MudText>
            <MudDivider Vertical="true" />
            <MudText>Departures</MudText>
        </MudPaper>
    </div>
</MudStack>
