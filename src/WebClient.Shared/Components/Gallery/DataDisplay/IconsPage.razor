@page "/components/icons"
@attribute [ComponentPage("Icons", GalleryGroup.DataDisplay, "MudIcon draws an SVG icon from the bundled Material sets or from your own path data. Use it beside text to aid scanning; an icon that stands alone needs an accessible name.", MudDocs = "icons", Types = ["MudIcon", "Icons"])]

<ComponentPageFrame Page="GetType()">
    <Example Of="typeof(IconStyles)" Title="Five Material styles" Description="Every Material icon ships in Filled, Outlined, Rounded, Sharp and TwoTone. Pick one style for the whole product; mixing them looks accidental." PreviewClass="example-preview-flush" />
    <Example Of="typeof(IconSizesAndColors)" Title="Every size and color" Description="Size × Color, rendered from the enums. Disabled drops the Color, so the icon inherits the text color. For any other size, set font-size: the SVG scales with it." PreviewClass="example-preview-flush" />
    <Example Of="typeof(IconMeaning)" Title="Decorative and meaningful icons" Description="An icon next to a label is decoration and stays hidden from screen readers. An icon that carries meaning on its own gets a Title, which becomes the SVG's accessible name." />
    <Example Of="typeof(IconCustomSvg)" Title="Custom SVG icons" Description="Icon accepts SVG markup, so your own glyphs behave like Material ones: they take Color and Size. ViewBox matches the coordinate system you drew in." />
    <Example Of="typeof(IconPicker)" Title="Searchable icon picker" Description="The icon constants are found by reflection, filtered as you type and capped at 200 results so the grid stays fast. Choose a style, then pick an icon to get its constant." PreviewClass="example-preview-flush" />
    <Example Of="typeof(IconPlayground)" Title="Playground" Description="Change any parameter; the markup below updates with only the values that differ from the defaults." PreviewClass="example-preview-flush" />
</ComponentPageFrame>
