@page "/components/table"
@attribute [ComponentPage("Table", GalleryGroup.DataDisplay, "A row-and-column table with sorting, paging, selection, grouping and inline editing that you lay out cell by cell. Choose it when you want full control over the markup of each row; choose the data grid when columns should be declared once and configured by the user.", MudDocs = "table", Types = ["MudTable", "MudTh", "MudTd", "MudTableSortLabel", "MudTablePager"])]

<ComponentPageFrame Page="GetType()">
    <Example Of="typeof(TableBasics)" Title="Basic table" Description="Items, a header row and a row template. Each MudTd carries a DataLabel, so on narrow screens (below Breakpoint) rows stack into labelled cards." PreviewClass="example-preview-flush" />
    <Example Of="typeof(TableAppearance)" Title="Dense, hover, striped and bordered" Description="The four appearance switches combine freely. These presets show the useful pairings side by side; the playground at the end lets you try every combination." />
    <Example Of="typeof(TableSortingFilteringPaging)" Title="Sorting, filtering and paging" Description="MudTableSortLabel sorts by a key selector, Filter hides rows that do not match the search, and MudTablePager pages whatever remains. Sorting and filtering run before paging." PreviewClass="example-preview-flush" />
    <Example Of="typeof(TableSelection)" Title="Selecting rows" Description="MultiSelection adds a checkbox column and a select-all box in the header. RowDisabledFunc keeps rows visible but out of reach, and SelectedItems is a plain HashSet you can bind." PreviewClass="example-preview-flush" />
    <Example Of="typeof(TableInlineEditing)" Title="Inline editing with commit and cancel" Description="RowEditingTemplate replaces a row while it is edited. RowEditPreview takes a backup, RowEditCancel restores it, and RowEditCommit accepts the change only when it is valid." PreviewClass="example-preview-flush" />
    <Example Of="typeof(TableGrouping)" Title="Grouping with subtotals" Description="GroupBy takes a TableGroupDefinition with a selector. Group headers can collapse, and group footers are a natural place for subtotals." PreviewClass="example-preview-flush" />
    <Example Of="typeof(TableFixedHeader)" Title="Fixed header, footer and virtualization" Description="With Height set, FixedHeader and FixedFooter keep the column names and totals in view while 2,000 virtualized rows scroll between them." PreviewClass="example-preview-flush" />
    <Example Of="typeof(TableServerData)" Title="Server-side data with cancellation" Description="ServerData receives the page, page size and sort, plus a CancellationToken. A new request cancels the previous one, so a slow, stale response never replaces a newer page." PreviewClass="example-preview-flush" />
    <Example Of="typeof(TableRowDetails)" Title="Row click details" Description="OnRowClick reports the clicked item. Here it opens a detail panel, and RowStyleFunc marks the row the panel describes. A Details button in each row does the same from the keyboard." PreviewClass="example-preview-flush" />
    <Example Of="typeof(TablePlayground)" Title="Playground" Description="Switch any appearance parameter; the markup below lists only the values that differ from the defaults." PreviewClass="example-preview-flush" />
</ComponentPageFrame>
