<MudCard Outlined="true" Style="max-width: 24rem">
    <MudCardContent>
        <MudText Typo="Typo.overline" HtmlTag="p" Color="Color.Primary">Service notice</MudText>
        <MudText Typo="Typo.h6" HtmlTag="h3" GutterBottom="true">Riverside line closed on Sunday</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            Track renewal between Old Market and University. Replacement buses run every ten minutes from 06:00 to 23:30.
        </MudText>
    </MudCardContent>
    <MudCardActions>
        <MudButton Variant="Variant.Text" Color="Color.Primary">Plan a journey</MudButton>
        <MudButton Variant="Variant.Text">Bus stops</MudButton>
    </MudCardActions>
</MudCard>
