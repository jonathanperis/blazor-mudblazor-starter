@page "/components/divider"
@attribute [ComponentPage("Divider", GalleryGroup.DataDisplay, "MudDivider draws a thin rule between groups of content, horizontally or vertically. Use it when spacing alone does not separate the groups clearly.", MudDocs = "divider", Types = ["MudDivider"])]

<ComponentPageFrame Page="GetType()">
    <Example Of="typeof(DividerTypes)" Title="Full width, inset and middle" Description="DividerType controls where the rule starts and ends. Inset lines up with text after a leading avatar or icon; Middle leaves margin on both sides." />
    <Example Of="typeof(DividerVertical)" Title="Vertical dividers in a row" Description="Vertical dividers separate items in a toolbar or a row of facts. FlexItem makes the rule as tall as the row; without it the rule has no height in a flex container." />
    <Example Of="typeof(DividerLight)" Title="Regular and light" Description="Light uses the lighter divider color from the palette, for separators inside an already outlined surface." />
    <Example Of="typeof(DividerReceipt)" Title="A sectioned receipt" Description="Dividers in context: an order summary from a bakery, where rules separate the items, the totals and the footer." />
    <Example Of="typeof(DividerPlayground)" Title="Playground" Description="Change any parameter; the markup below updates with only the values that differ from the defaults." PreviewClass="example-preview-flush" />
</ComponentPageFrame>
