<MudGrid Spacing="4">
    @foreach (var preset in _presets)
    {
        <MudItem xs="12" sm="6">
            <MudText Typo="Typo.overline" HtmlTag="h3" Class="mb-1">@preset.Name</MudText>
            <MudSimpleTable Dense="preset.Dense" Hover="preset.Hover" Striped="preset.Striped" Bordered="preset.Bordered"
                            Outlined="preset.Outlined" Elevation="preset.Elevation">
                <thead>
                    <tr><th scope="col">Zone</th><th scope="col" style="text-align: right">Single</th><th scope="col" style="text-align: right">Day</th></tr>
                </thead>
                <tbody>
                    @foreach (var fare in _fares)
                    {
                        <tr><td>@fare.Zone</td><td style="text-align: right">@fare.Single</td><td style="text-align: right">@fare.Day</td></tr>
                    }
                </tbody>
            </MudSimpleTable>
        </MudItem>
    }
</MudGrid>

@code {
    private record Preset(string Name, bool Dense = false, bool Hover = false, bool Striped = false, bool Bordered = false, bool Outlined = true, int Elevation = 0);
    private record Fare(string Zone, string Single, string Day);

    private readonly Preset[] _presets =
    [
        new("Default: elevation 1, not outlined", Outlined: false, Elevation: 1),
        new("Outlined, no elevation"),
        new("Dense + striped", Dense: true, Striped: true),
        new("Bordered", Bordered: true),
        new("Hover: point at a row", Hover: true),
        new("All of them", Dense: true, Hover: true, Striped: true, Bordered: true)
    ];

    private readonly Fare[] _fares =
    [
        new("Zone 1", "£1.80", "£4.50"),
        new("Zones 1–2", "£2.40", "£6.00"),
        new("Zones 1–3", "£3.10", "£7.80"),
        new("Airport", "£5.50", "£11.00"),
        new("Night bus", "£2.00", "Not sold")
    ];
}
