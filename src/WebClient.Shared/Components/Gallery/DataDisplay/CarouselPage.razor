@page "/components/carousel"
@attribute [ComponentPage("Carousel", GalleryGroup.DataDisplay, "Slides shown one at a time with arrows, bullets, swipe and optional auto-cycling. Use it for a handful of related highlights; anything people must read or compare belongs on the page instead, where nothing moves away.", MudDocs = "carousel", Types = ["MudCarousel", "MudCarouselItem"])]

<ComponentPageFrame Page="GetType()">
    <Example Of="typeof(CarouselBasics)" Title="Basic carousel" Description="MudCarouselItem children become slides. Give the carousel a height; each slide fills it. Arrows, bullets, swipe and auto-cycling are on by default; this one turns auto-cycling off." PreviewClass="example-preview-flush" />
    <Example Of="typeof(CarouselAutoCycle)" Title="Auto-cycling with a pause control" Description="AutoCycle advances every AutoCycleTime. Moving content needs a way to stop it, so the button pauses and resumes, and SelectedIndex reports the slide on screen." PreviewClass="example-preview-flush" />
    <Example Of="typeof(CarouselNavigation)" Title="Arrow and bullet positions" Description="ArrowsPosition places the arrows at the top, centre or bottom, and BulletsPosition puts the bullets above or below. Every combination, side by side." PreviewClass="example-preview-flush" />
    <Example Of="typeof(CarouselTransitions)" Title="Transitions" Description="Each item chooses Slide, Fade or None. Custom takes your own CSS classes for entering and leaving; here MudBlazor's fade-in is paired with its slide-out." PreviewClass="example-preview-flush" />
    <Example Of="typeof(CarouselCustomBullets)" Title="Custom bullets and your own buttons" Description="BulletTemplate receives whether its slide is selected. Templates (including PreviousButtonTemplate and NextButtonTemplate) render inside plain divs rather than buttons, so this example draws the marks with the template and navigates with real buttons bound to SelectedIndex." PreviewClass="example-preview-flush" />
    <Example Of="typeof(CarouselDataBound)" Title="Data-bound slides" Description="ItemsSource with an ItemTemplate builds slides from data. Bind SelectedIndex to jump to a slide, and adding or removing items updates the carousel." PreviewClass="example-preview-flush" />
    <Example Of="typeof(CarouselSvgSlides)" Title="Tonight's sky, in SVG" Description="Slides built from inline SVG drawn with theme colors, so they follow light and dark mode and need no image files. Each drawing has a text alternative." PreviewClass="example-preview-flush" />
    <Example Of="typeof(CarouselPlayground)" Title="Playground" Description="Change the navigation, timing and transition; the markup lists only the values that differ from the defaults." PreviewClass="example-preview-flush" />
</ComponentPageFrame>
