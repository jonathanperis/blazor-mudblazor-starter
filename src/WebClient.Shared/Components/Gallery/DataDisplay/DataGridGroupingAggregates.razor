<MudDataGrid @ref="_grid" Items="_readings" Groupable="true" GroupExpanded="true" Dense="true" Elevation="0" Culture="Invariant">
    <ToolBarContent>
        <MudText Typo="Typo.h6" HtmlTag="h3">A week at three stations</MudText>
        <MudSpacer />
        <MudButton Size="Size.Small" OnClick="() => _grid.ExpandAllGroupsAsync()">Expand all</MudButton>
        <MudButton Size="Size.Small" OnClick="() => _grid.CollapseAllGroupsAsync()">Collapse all</MudButton>
    </ToolBarContent>
    <Columns>
        <PropertyColumn Property="reading => reading.Station" Grouping="true">
            <GroupTemplate>
                <strong>@context.Grouping.Key</strong>
                <MudText Typo="Typo.caption" Inline="true" Class="ml-2">@context.Grouping.Count() days</MudText>
            </GroupTemplate>
        </PropertyColumn>
        <PropertyColumn Property="reading => reading.Day" Groupable="false" />
        <PropertyColumn Property="reading => reading.HighC" Title="High (°C)" Groupable="false" Format="0.0" AggregateDefinition="_averageHigh" />
        <PropertyColumn Property="reading => reading.RainMm" Title="Rain (mm)" Groupable="false" Format="0.0" AggregateDefinition="_totalRain" />
        <PropertyColumn Property="reading => reading.GustKmh" Title="Gust (km/h)" Groupable="false" AggregateDefinition="_strongestGust" />
    </Columns>
</MudDataGrid>

@code {
    private record Reading(string Station, string Day, double HighC, double RainMm, int GustKmh);

    private static readonly CultureInfo Invariant = CultureInfo.InvariantCulture;
    private MudDataGrid<Reading> _grid = null!;

    private readonly AggregateDefinition<Reading> _averageHigh = new()
    {
        Type = AggregateType.Avg, NumberFormat = "0.0", DisplayFormat = "Mean {value} °C"
    };

    private readonly AggregateDefinition<Reading> _totalRain = new()
    {
        Type = AggregateType.Sum, NumberFormat = "0.0", DisplayFormat = "Total {value} mm"
    };

    // A custom aggregate can say more than one number: here the day the strongest gust came.
    private readonly AggregateDefinition<Reading> _strongestGust = new()
    {
        Type = AggregateType.Custom,
        CustomAggregate = readings => readings.MaxBy(reading => reading.GustKmh) is { } peak ? $"Peak {peak.GustKmh} on {peak.Day}" : ""
    };

    private readonly Reading[] _readings =
    [
        new("Ben Alder ridge", "Mon", 8.1, 0.0, 54), new("Ben Alder ridge", "Tue", 6.4, 4.2, 71), new("Ben Alder ridge", "Wed", 7.9, 1.0, 48),
        new("Loch Ossian shore", "Mon", 12.3, 0.4, 22), new("Loch Ossian shore", "Tue", 10.8, 6.6, 35), new("Loch Ossian shore", "Wed", 11.5, 2.1, 19),
        new("Harbour wall", "Mon", 14.2, 0.0, 30), new("Harbour wall", "Tue", 13.1, 3.4, 44), new("Harbour wall", "Wed", 14.8, 0.0, 26)
    ];
}
