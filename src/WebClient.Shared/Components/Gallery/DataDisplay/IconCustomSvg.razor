<MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.End" Spacing="8">
    <MudStack AlignItems="AlignItems.Center" Spacing="1">
        <MudIcon Icon="@Observatory" ViewBox="0 0 32 32" Size="Size.Large" Color="Color.Primary" Title="Observatory" />
        <MudText Typo="Typo.caption">ViewBox 0 0 32 32</MudText>
    </MudStack>
    <MudStack AlignItems="AlignItems.Center" Spacing="1">
        <MudIcon Icon="@Observatory" ViewBox="0 0 32 32" Color="Color.Secondary" Title="Observatory" />
        <MudText Typo="Typo.caption">Size.Medium, Secondary</MudText>
    </MudStack>
    <MudStack AlignItems="AlignItems.Center" Spacing="1">
        <MudIcon Icon="@Observatory" ViewBox="0 0 32 32" Size="Size.Small" Title="Observatory" />
        <MudText Typo="Typo.caption">Size.Small, inherited color</MudText>
    </MudStack>
    <MudStack AlignItems="AlignItems.Center" Spacing="1">
        <MudIcon Icon="@Loaf" Size="Size.Large" Color="Color.Tertiary" Title="Bread" />
        <MudText Typo="Typo.caption">Default 24 × 24 grid</MudText>
    </MudStack>
    <MudStack AlignItems="AlignItems.Center" Spacing="1">
        <MudIcon Icon="@Icons.Custom.Brands.GitHub" Size="Size.Large" Title="GitHub" />
        <MudText Typo="Typo.caption">Icons.Custom.Brands</MudText>
    </MudStack>
</MudStack>

@code {
    // Shapes use currentColor (the default fill), so Color and Disabled keep working.
    // fill-rule="evenodd" cuts the slit, the door and the score marks out of the solid shapes.
    private const string Observatory =
        "<path fill-rule=\"evenodd\" d=\"M5 18a11 11 0 0 1 22 0zM15 8h2v10h-2z\"/>" +
        "<path fill-rule=\"evenodd\" d=\"M6 19h20v9H6zM14 22h4v6h-4z\"/>" +
        "<path d=\"M16.5 10 22 4.5l1.6 1.6-5.5 5.5z\"/>";

    private const string Loaf =
        "<path fill-rule=\"evenodd\" d=\"M3 12a9 6 0 0 1 18 0v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2zM7.5 10.5l1.4-1.4 2.2 2.2-1.4 1.4zM12.5 10.5l1.4-1.4 2.2 2.2-1.4 1.4z\"/>";
}
