@using System.Reflection

<MudGrid Spacing="0">
    <MudItem xs="12" md="8" Class="pa-5">
        <MudStack Spacing="3">
            <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Spacing="3">
                <MudTextField @bind-Value="_query" Label="Search icons" Placeholder="calendar, train, star…" Immediate="true" Clearable="true"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search"
                              Style="min-width: 14rem" />
                <MudSelect @bind-Value="_style" Label="Style" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 10rem">
                    @foreach (var style in Styles.Keys) { <MudSelectItem Value="style">@style</MudSelectItem> }
                </MudSelect>
            </MudStack>
            <MudText Typo="Typo.caption" Class="mud-text-secondary" role="status">@Summary</MudText>
            <div style="display: grid; gap: .25rem; grid-template-columns: repeat(auto-fill, minmax(2.75rem, 1fr)); max-height: 19rem; overflow-y: auto">
                @foreach (var icon in Visible)
                {
                    <MudIconButton @key="icon.Name" Icon="@icon.Svg" aria-label="@icon.Name" aria-pressed="@(icon.Name == _selected ? "true" : "false")"
                                   Color="@(icon.Name == _selected ? Color.Primary : Color.Default)" Variant="@(icon.Name == _selected ? Variant.Outlined : Variant.Text)"
                                   OnClick="() => _selected = icon.Name" />
                }
            </div>
        </MudStack>
    </MudItem>
    <MudItem xs="12" md="4" Class="pa-5" Style="border-inline-start: 1px solid var(--mud-palette-divider)">
        @if (SelectedSvg is { } svg)
        {
            <MudStack AlignItems="AlignItems.Center" Spacing="3">
                <MudIcon Icon="@svg" Color="Color.Primary" Style="font-size: 5rem" />
                <MudText Typo="Typo.h6" HtmlTag="p">@_selected</MudText>
                <MudPaper Outlined="true" Class="pa-2" Style="max-width: 100%">
                    @* <wbr> lets a long constant break after a dot instead of mid-word. *@
                    <code>Icons.Material.<wbr />@(_style).<wbr />@_selected</code>
                </MudPaper>
            </MudStack>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Pick an icon to see its constant.</MudText>
        }
    </MudItem>
</MudGrid>

@code {
    private const int MaxShown = 200;

    // typeof(...).GetFields directly on each class lets the trimmer keep the fields in the WebAssembly build.
    private static readonly Dictionary<string, IReadOnlyList<(string Name, string Svg)>> Styles = new()
    {
        ["Filled"] = Read(typeof(Icons.Material.Filled).GetFields(BindingFlags.Public | BindingFlags.Static)),
        ["Outlined"] = Read(typeof(Icons.Material.Outlined).GetFields(BindingFlags.Public | BindingFlags.Static)),
        ["Rounded"] = Read(typeof(Icons.Material.Rounded).GetFields(BindingFlags.Public | BindingFlags.Static)),
        ["Sharp"] = Read(typeof(Icons.Material.Sharp).GetFields(BindingFlags.Public | BindingFlags.Static)),
        ["TwoTone"] = Read(typeof(Icons.Material.TwoTone).GetFields(BindingFlags.Public | BindingFlags.Static))
    };

    private string _query = "";
    private string _style = "Outlined";
    private string? _selected = "Train";

    private IReadOnlyList<(string Name, string Svg)> All => Styles[_style];
    private IEnumerable<(string Name, string Svg)> Matches => All.Where(icon => icon.Name.Contains(_query?.Trim() ?? "", StringComparison.OrdinalIgnoreCase));
    private IEnumerable<(string Name, string Svg)> Visible => Matches.Take(MaxShown);
    private string? SelectedSvg => All.FirstOrDefault(icon => icon.Name == _selected).Svg;

    private string Summary
    {
        get
        {
            var count = Matches.Count();
            return count switch
            {
                0 => "No icons match. Try a shorter word.",
                > MaxShown => $"Showing the first {MaxShown} of {count} icons. Type to narrow the list.",
                _ => $"{count} icons."
            };
        }
    }

    private static IReadOnlyList<(string Name, string Svg)> Read(FieldInfo[] fields) =>
        fields.Where(field => field.FieldType == typeof(string))
              .Select(field => (field.Name, Svg: (string)field.GetValue(null)!))
              .OrderBy(icon => icon.Name, StringComparer.Ordinal)
              .ToList();
}
