@inject ILogger<BrowserDiagnosticsPanel> Logger

<MudText Typo="Typo.h6" HtmlTag="h2">Follow one browser event</MudText>
<MudButton OnClick="Probe" Color="Color.Primary" Variant="Variant.Filled" Class="my-3">Write a diagnostic log entry</MudButton>
<MudText role="status">@_status</MudText>
<MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="my-4">
    WebAssembly logs go to the browser console: open the developer tools to find the entry. This static demo has no server, so it has no
    health endpoints or server logs. Run the app locally or in Docker to try <code>/healthz</code>, <code>/healthz/ready</code> and server traces.
</MudAlert>
<MudLink Href="https://jonathanperis.github.io/blazor-mudblazor-starter/docs/deployment/" Target="_blank" rel="noopener noreferrer">Docker and hosting guide</MudLink>

@code {
    private string _status = "No entry written.";

    private void Probe()
    {
        var traceId = ActivityTraceId.CreateRandom().ToString();
        Logger.LogInformation("Learning diagnostic event {TraceId}", traceId);
        _status = $"Logged trace ID {traceId}. Find “Learning diagnostic event” in the browser console.";
    }
}
