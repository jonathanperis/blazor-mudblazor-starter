<Project Sdk="Microsoft.NET.Sdk.Razor">
  <!-- Build-time tool: renders every page of the static demo to HTML, so GitHub Pages serves content before .NET starts. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../WebClient.Shared/WebClient.Shared.csproj" />
  </ItemGroup>
</Project>
