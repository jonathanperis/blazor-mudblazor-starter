<EditForm Model="_model" OnValidSubmit="Confirm">
    <DataAnnotationsValidator />
    <MudDialog>
        <DialogContent><ForecastFields Model="_model" /></DialogContent>
        <DialogActions>
            <MudButton OnClick="Cancel">Cancel</MudButton>
            <MudButton ButtonType="ButtonType.Submit" Color="Color.Primary">Add record</MudButton>
        </DialogActions>
    </MudDialog>
</EditForm>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    private readonly WeatherForecast _model = new();
    private void Cancel() => MudDialog.Cancel();
    private void Confirm() => MudDialog.Close(DialogResult.Ok(_model));
}
