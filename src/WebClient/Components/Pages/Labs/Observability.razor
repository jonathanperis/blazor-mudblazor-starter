@page "/labs/observability"
@inject IHttpClientFactory Clients
@implements IDisposable

<LabFrame Slug="observability" OnReset="Reset" ResetDisabled="_busy">
    <MudText Typo="Typo.h6" HtmlTag="h2">Follow one request</MudText>
    <MudButton OnClick="Probe" Disabled="_busy" Color="Color.Primary" Variant="Variant.Filled" Class="my-3">Send diagnostic request</MudButton>
    <MudText role="status">@_status</MudText>
    <MudStack Row Class="flex-wrap my-4">
        <MudLink Href="/healthz" Target="_blank">Host liveness</MudLink>
        <MudLink Href="/healthz/ready" Target="_blank">SQLite readiness</MudLink>
        <MudLink Href="https://jonathanperis.github.io/blazor-mudblazor-starter/docs/deployment/" Target="_blank" rel="noopener noreferrer">Docker and hosting guide</MudLink>
    </MudStack>
    <MudText>Find “Learning diagnostic request” and the returned trace ID in the server console. Set APPLICATIONINSIGHTS_CONNECTION_STRING only when you want requests exported to your own Azure resource.</MudText>
</LabFrame>

@code {
    private string _status = "No request sent.";
    private bool _busy;
    private readonly CancellationTokenSource _lifetime = new();
    private void Reset() => _status = "No request sent.";
    private async Task Probe()
    {
        _busy = true;
        try { _status = await Clients.CreateClient("LearningApi").GetStringAsync("api/diagnostics", _lifetime.Token); }
        catch (HttpRequestException) { _status = "Could not reach the diagnostics API. Check Learning:ApiBaseUrl."; }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (OperationCanceledException) { _status = "The diagnostics request timed out. Try again."; }
        finally { _busy = false; }
    }
    public void Dispose() { _lifetime.Cancel(); _lifetime.Dispose(); }
}
