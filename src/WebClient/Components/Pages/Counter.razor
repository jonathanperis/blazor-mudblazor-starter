@page "/counter"
@inject CircuitCounter Circuit

<LabFrame Slug="state" OnReset="Reset">
    <MudText Typo="Typo.h6" HtmlTag="h2">Two lifetimes, one page</MudText>
    <div role="status" aria-live="polite" class="my-3">
        <p>Component count: <strong data-testid="component-count">@_count</strong></p>
        <p>Circuit count: <strong>@Circuit.Count</strong></p>
    </div>
    <MudStack Row Class="flex-wrap mb-4">
        <CounterControl @bind-Value="_count" />
        <MudButton Variant="Variant.Outlined" OnClick="() => Circuit.Count++">Increment circuit count</MudButton>
    </MudStack>
    <MudText Typo="Typo.body2">Circuit-scoped service instance: @Circuit.Id.ToString("N")[..8]</MudText>
    <MudText Typo="Typo.body2">Lifecycle: @(_interactive ? "Interactive component: OnAfterRenderAsync has run." : "Prerendered component: browser interop is not available yet.")</MudText>
</LabFrame>

@code {
    private int _count;
    private bool _interactive;
    private void Reset() { _count = 0; Circuit.Count = 0; }
    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) { _interactive = true; StateHasChanged(); }
        return Task.CompletedTask;
    }
}
