@page "/weather"
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject IJSRuntime Js

<LabFrame Slug="grid" OnReset="Reset">
    <MudStack Row Class="flex-wrap mb-4" AlignItems="AlignItems.Center">
        <MudSelect T="int" Label="Dataset size" @bind-Value="_size">
            @foreach (var size in ForecastData.Sizes) { <MudSelectItem Value="size">@size.ToString("N0")</MudSelectItem> }
        </MudSelect>
        <MudNumericField T="int" Label="Random seed" @bind-Value="_seed" />
        <MudButton OnClick="Reset" Variant="Variant.Outlined">Generate dataset</MudButton>
    </MudStack>
    <MudText Typo="Typo.body2" Class="mb-3">@_forecasts.Count.ToString("N0") records in component memory · generation @_generationMs ms · edits reset on navigation/reload. This timing measures generation, not browser rendering.</MudText>
    <MudStack Row Class="flex-wrap mb-3" AlignItems="AlignItems.Center">
        <MudButton OnClick="Add" StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" Variant="Variant.Filled">Add record</MudButton>
        <MudButton OnClick="Remove" Disabled="@(_selected.Count == 0)" Color="Color.Error">Remove selected</MudButton>
        <MudButton OnClick="CopySelected" Disabled="@(_selected.Count == 0 || _selected.Count > ForecastCsv.MaxRows)">Copy selected as CSV</MudButton>
        <MudText Typo="Typo.body2" role="status">@_selected.Count selected (copy limit: @ForecastCsv.MaxRows)</MudText>
    </MudStack>
    <MudDataGrid T="WeatherForecast" @key="_gridKey" Items="_forecasts" MultiSelection="true" @bind-SelectedItems="_selected" @bind-CurrentPage="_page"
                 QuickFilter="Filter" SortMode="SortMode.Multiple" Filterable="true" Hideable="true" Virtualize="true"
                 FixedHeader="true" Height="30rem" HorizontalScrollbar="true" RowContextMenuClick="RightClick">
        <ToolBarContent>
            <MudTextField T="string" @bind-Value="_search" Label="Search records" DebounceInterval="300" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
        </ToolBarContent>
        <Columns>
            <SelectColumn T="WeatherForecast" />
            <TemplateColumn Title="Record" Sortable="false" Filterable="false"><CellTemplate>@context.Item.Id.ToString("N")[..8]</CellTemplate></TemplateColumn>
            <PropertyColumn Property="x => x.Date" Title="Date" Format="d" />
            <PropertyColumn Property="x => x.TemperatureC" Title="°C" />
            <PropertyColumn Property="x => x.TemperatureF" Title="°F" />
            <PropertyColumn Property="x => x.Summary" Title="Summary" />
            <TemplateColumn Title="Actions" Sortable="false" Filterable="false">
                <CellTemplate>
                    <MudIconButton Icon="@Icons.Material.Outlined.Edit" aria-label="Edit record" OnClick="() => Edit(context.Item)" />
                    <MudIconButton Icon="@Icons.Material.Outlined.ContentCopy" aria-label="Copy record as CSV" OnClick="() => Copy([context.Item])" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent><MudText>No matching records. Clear the search or reset the dataset.</MudText></NoRecordsContent>
        <PagerContent><MudDataGridPager T="WeatherForecast" PageSizeOptions="[10, 25, 100, 1000]" /></PagerContent>
    </MudDataGrid>
    <MudMenu @ref="_menu" PositionAtCursor="true">
        <MudMenuItem OnClick="CopyContext">Copy row as CSV</MudMenuItem>
        <MudMenuItem OnClick="CopySelected" Disabled="@(_selected.Count == 0 || _selected.Count > ForecastCsv.MaxRows)">Copy selected as CSV</MudMenuItem>
    </MudMenu>
</LabFrame>

@code {
    private List<WeatherForecast> _forecasts = [];
    private HashSet<WeatherForecast> _selected = [];
    private int _gridKey;
    private int _page;
    private MudMenu _menu = null!;
    private WeatherForecast? _context;
    private int _size = 100;
    private int _seed = 42;
    private long _generationMs;
    private string _search = "";
    private bool Filter(WeatherForecast row) => ForecastData.Matches(row, _search);

    protected override void OnInitialized() => Generate();
    private void Generate()
    {
        var timer = Stopwatch.StartNew();
        _forecasts = ForecastData.Generate(_size, _seed);
        _selected = [];
        _context = null;
        _search = "";
        _page = 0;
        _gridKey++;
        _generationMs = timer.ElapsedMilliseconds;
    }
    private void Reset() => Generate();
    private async Task Add()
    {
        var dialog = await Dialogs.ShowAsync<AddWeather>("Add record", new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (await dialog.Result is { Canceled: false, Data: WeatherForecast record })
        {
            _forecasts = [record, .. _forecasts];
            _page = 0;
            Snackbar.Add("Record added. Clear filters if it is outside the current view.", Severity.Success);
        }
    }
    private async Task Edit(WeatherForecast record)
    {
        var dialog = await Dialogs.ShowAsync<EditWeather>("Edit record", new DialogParameters<EditWeather> { { x => x.Item, record } });
        if (await dialog.Result is { Canceled: false, Data: WeatherForecast draft })
        {
            record.Apply(draft);
            _forecasts = [.. _forecasts];
            Snackbar.Add("Changes saved.", Severity.Success);
        }
    }
    private async Task Remove()
    {
        var selected = _selected.ToHashSet();
        if (selected.Count == 0) return;
        var dialog = await Dialogs.ShowAsync<RemoveWeather>("Remove records", new DialogParameters<RemoveWeather> { { x => x.Count, selected.Count } });
        if (await dialog.Result is { Canceled: false })
        {
            _forecasts = _forecasts.Where(row => !selected.Contains(row)).ToList();
            _selected = [];
            _context = null;
            Snackbar.Add($"Removed {selected.Count} records.", Severity.Success);
        }
    }
    private async Task RightClick(DataGridRowClickEventArgs<WeatherForecast> args) { _context = args.Item; await _menu.OpenMenuAsync(args.MouseEventArgs); }
    private Task CopyContext() => _context is null ? Task.CompletedTask : Copy([_context]);
    private Task CopySelected() => _selected.Count is > 0 and <= ForecastCsv.MaxRows ? Copy(_selected.OrderBy(row => row.Date)) : Task.CompletedTask;
    private async Task Copy(IEnumerable<WeatherForecast> rows)
    {
        var copied = await Js.InvokeAsync<bool>("learningFiles.copy", ForecastCsv.Export(rows));
        Snackbar.Add(copied ? "CSV copied." : "Clipboard unavailable. Use HTTPS or allow clipboard access in your browser.", copied ? Severity.Success : Severity.Info);
    }
}
