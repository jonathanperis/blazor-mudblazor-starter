<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!-- Static WebAssembly host for the GitHub Pages live demo. Server-only labs use browser stand-ins. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- Culture experiments need ICU data for pt-BR, not only the browser's default shard. -->
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
    <SatelliteResourceLanguages>en;pt;pt-BR</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../WebClient.Shared/WebClient.Shared.csproj" />
  </ItemGroup>

</Project>
